<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Cut-off Expense Monitor</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
  <style>
    :root {
      --primary: #6366f1;
      --primary-d: #4f46e5;
      --success: #22c55e;
      --warning: #f59e0b;
      --danger: #ef4444;
      --purple: #a855f7;
      --bg: #f1f5f9;
      --card: #ffffff;
      --text: #1e293b;
      --muted: #94a3b8;
      --border: #e2e8f0;
      --sidebar-w: 220px;
      --radius: 12px;
      --shadow: 0 1px 3px rgba(0, 0, 0, .08), 0 4px 16px rgba(0, 0, 0, .05);
      --shadow-lg: 0 8px 30px rgba(0, 0, 0, .14);
    }

    /* ── Dark mode ── */
    [data-theme="dark"] {
      --bg: #0f172a;
      --card: #1e293b;
      --text: #f1f5f9;
      --muted: #64748b;
      --border: #334155;
      --shadow: 0 1px 3px rgba(0, 0, 0, .3), 0 4px 16px rgba(0, 0, 0, .2);
    }

    [data-theme="dark"] .sidebar {
      background: #1e293b;
    }

    [data-theme="dark"] .mobile-nav {
      background: #1e293b;
    }

    [data-theme="dark"] input,
    [data-theme="dark"] select,
    [data-theme="dark"] textarea {
      background: #0f172a;
      color: var(--text);
      border-color: var(--border);
    }

    [data-theme="dark"] tr:hover {
      background: #273548;
    }

    /* ── Dark mode toggle button ── */
    .theme-btn {
      background: var(--bg);
      border: 1px solid var(--border);
      border-radius: 10px;
      width: 38px;
      height: 38px;
      cursor: pointer;
      font-size: 17px;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: background .15s;
    }

    .theme-btn:hover {
      background: var(--border);
    }

    /* ── Help modal ── */
    .help-overlay {
      position: fixed;
      inset: 0;
      z-index: 1100;
      background: rgba(0, 0, 0, .55);
      display: none;
      align-items: center;
      justify-content: center;
      padding: 20px;
    }

    .help-overlay.open {
      display: flex;
    }

    .help-modal {
      background: var(--card);
      border-radius: 20px;
      width: 100%;
      max-width: 760px;
      max-height: 88vh;
      display: flex;
      flex-direction: column;
      box-shadow: 0 24px 80px rgba(0, 0, 0, .4);
      overflow: hidden;
    }

    .help-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 20px 24px 16px;
      border-bottom: 1px solid var(--border);
    }

    .help-header h2 {
      font-size: 17px;
      font-weight: 800;
      color: var(--text);
    }

    .help-header p {
      font-size: 12px;
      color: var(--muted);
      margin-top: 2px;
    }

    .help-close {
      width: 32px;
      height: 32px;
      border-radius: 8px;
      border: 1px solid var(--border);
      background: var(--bg);
      cursor: pointer;
      font-size: 16px;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .help-steps-nav {
      display: flex;
      gap: 4px;
      padding: 14px 24px 0;
      overflow-x: auto;
      flex-shrink: 0;
      scrollbar-width: none;
    }

    .help-steps-nav::-webkit-scrollbar {
      display: none;
    }

    .help-step-tab {
      flex-shrink: 0;
      padding: 6px 14px;
      border-radius: 20px;
      border: 1.5px solid var(--border);
      font-size: 12px;
      font-weight: 600;
      font-family: inherit;
      color: var(--muted);
      background: var(--bg);
      cursor: pointer;
      transition: all .15s;
      white-space: nowrap;
    }

    .help-step-tab.active {
      background: var(--primary);
      color: #fff;
      border-color: var(--primary);
    }

    .help-body {
      flex: 1;
      overflow-y: auto;
      padding: 20px 24px 24px;
    }

    .help-slide {
      display: none;
    }

    .help-slide.active {
      display: block;
    }

    .help-slide-header {
      display: flex;
      align-items: flex-start;
      gap: 16px;
      margin-bottom: 20px;
    }

    .help-step-icon {
      width: 52px;
      height: 52px;
      border-radius: 14px;
      background: linear-gradient(135deg, var(--primary), var(--primary-d));
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 24px;
      flex-shrink: 0;
      box-shadow: 0 4px 16px rgba(99, 102, 241, .3);
    }

    .help-slide-header h3 {
      font-size: 16px;
      font-weight: 800;
      color: var(--text);
    }

    .help-slide-header p {
      font-size: 13px;
      color: var(--muted);
      margin-top: 4px;
      line-height: 1.5;
    }

    /* Mockup screen */
    .help-mockup {
      border-radius: 12px;
      overflow: hidden;
      border: 1.5px solid var(--border);
      margin-bottom: 16px;
      background: #f8fafc;
      box-shadow: 0 4px 20px rgba(0, 0, 0, .08);
    }

    [data-theme="dark"] .help-mockup {
      background: #0f172a;
    }

    .mock-bar {
      height: 36px;
      background: linear-gradient(135deg, #1e1b4b, #4c1d95);
      display: flex;
      align-items: center;
      padding: 0 12px;
      gap: 6px;
    }

    .mock-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
    }

    .mock-body {
      padding: 14px;
    }

    .mock-row {
      display: flex;
      gap: 8px;
      align-items: center;
      background: #fff;
      border-radius: 8px;
      padding: 8px 10px;
      margin-bottom: 6px;
      border: 1px solid #e2e8f0;
      font-size: 12px;
      color: #475569;
    }

    [data-theme="dark"] .mock-row {
      background: #1e293b;
      border-color: #334155;
      color: #94a3b8;
    }

    .mock-badge {
      padding: 2px 8px;
      border-radius: 99px;
      font-size: 10px;
      font-weight: 700;
    }

    .mock-tag-paid {
      background: #dcfce7;
      color: #166534;
    }

    .mock-tag-unpaid {
      background: #fef9c3;
      color: #854d0e;
    }

    .mock-tag-over {
      background: #fee2e2;
      color: #991b1b;
    }

    .mock-tag-pend {
      background: #fef3c7;
      color: #92400e;
    }

    .mock-tag-act {
      background: #dcfce7;
      color: #166534;
    }

    .mock-btn {
      padding: 3px 10px;
      border-radius: 6px;
      background: var(--primary);
      color: #fff;
      font-size: 10px;
      font-weight: 700;
      margin-left: auto;
    }

    .help-tips {
      background: #f0fdf4;
      border: 1px solid #bbf7d0;
      border-radius: 10px;
      padding: 12px 14px;
      margin-top: 12px;
    }

    [data-theme="dark"] .help-tips {
      background: #0f2818;
      border-color: #166534;
    }

    .help-tips p {
      font-size: 12px;
      color: #166534;
      font-weight: 600;
      margin-bottom: 6px;
    }

    .help-tips li {
      font-size: 12px;
      color: #15803d;
      margin-left: 16px;
      margin-bottom: 3px;
    }

    [data-theme="dark"] .help-tips p,
    [data-theme="dark"] .help-tips li {
      color: #4ade80;
    }

    .help-footer {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 14px 24px;
      border-top: 1px solid var(--border);
      flex-shrink: 0;
    }

    .help-counter {
      font-size: 12px;
      color: var(--muted);
    }

    .help-nav-btns {
      display: flex;
      gap: 8px;
    }

    .help-nav-btn {
      padding: 7px 18px;
      border-radius: 8px;
      font-size: 13px;
      font-weight: 600;
      font-family: inherit;
      cursor: pointer;
      border: 1.5px solid var(--border);
      background: var(--bg);
      color: var(--text);
      transition: all .15s;
    }

    .help-nav-btn.primary {
      background: var(--primary);
      color: #fff;
      border-color: var(--primary);
    }

    .help-nav-btn:hover {
      opacity: .85;
    }

    /* ── Charts section ── */
    .charts-row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 16px;
      margin-bottom: 0;
    }

    .chart-card {
      background: var(--card);
      border-radius: var(--radius);
      box-shadow: var(--shadow);
      padding: 18px;
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    .chart-card h3 {
      font-size: 13px;
      font-weight: 700;
      color: var(--muted);
      text-transform: uppercase;
      letter-spacing: .04em;
    }

    .chart-canvas-wrap {
      position: relative;
      height: 220px;
    }

    /* ── Calendar view ── */
    .cal-wrap {
      padding: 16px 24px;
      overflow-y: auto;
      flex: 1;
    }

    .cal-grid {
      display: grid;
      grid-template-columns: repeat(7, 1fr);
      gap: 4px;
    }

    .cal-header {
      display: grid;
      grid-template-columns: repeat(7, 1fr);
      gap: 4px;
      margin-bottom: 4px;
    }

    .cal-dow {
      text-align: center;
      font-size: 11px;
      font-weight: 700;
      color: var(--muted);
      padding: 4px 0;
      text-transform: uppercase;
    }

    .cal-nav {
      display: flex;
      align-items: center;
      gap: 10px;
      margin-bottom: 12px;
    }

    .cal-nav h3 {
      font-size: 15px;
      font-weight: 700;
      flex: 1;
    }

    .cal-cell {
      min-height: 72px;
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: 4px 6px;
      cursor: default;
    }

    .cal-cell.today {
      border-color: var(--primary);
      box-shadow: 0 0 0 2px rgba(99, 102, 241, .2);
    }

    .cal-cell.other-month {
      opacity: .4;
    }

    .cal-day-num {
      font-size: 11px;
      font-weight: 700;
      color: var(--muted);
      margin-bottom: 2px;
    }

    .cal-bill-dot {
      font-size: 10px;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      border-radius: 4px;
      padding: 1px 4px;
      margin-top: 2px;
      font-weight: 600;
    }

    .cal-dot-unpaid {
      background: #fef3c7;
      color: #92400e;
    }

    .cal-dot-overdue {
      background: #fee2e2;
      color: #991b1b;
    }

    .cal-dot-paid {
      background: #dcfce7;
      color: #166534;
    }

    .view-toggle {
      display: flex;
      gap: 4px;
    }

    .view-btn {
      padding: 6px 12px;
      border: 1px solid var(--border);
      background: var(--card);
      border-radius: 8px;
      cursor: pointer;
      font-size: 12px;
      font-weight: 600;
      color: var(--muted);
      transition: all .15s;
    }

    .view-btn.active {
      background: var(--primary);
      color: #fff;
      border-color: var(--primary);
    }

    /* ── Budget progress ── */
    .budget-row {
      display: flex;
      flex-direction: column;
      gap: 8px;
      padding: 14px 0 4px;
    }

    .budget-item {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .budget-label {
      font-size: 12px;
      font-weight: 600;
      width: 90px;
      flex-shrink: 0;
    }

    .budget-bar-wrap {
      flex: 1;
      background: var(--bg);
      border-radius: 99px;
      height: 8px;
      overflow: hidden;
    }

    .budget-bar {
      height: 100%;
      border-radius: 99px;
      transition: width .5s;
    }

    .budget-pct {
      font-size: 11px;
      font-weight: 700;
      width: 36px;
      text-align: right;
      flex-shrink: 0;
    }

    .budget-btn {
      padding: 4px 10px;
      font-size: 11px;
      font-weight: 700;
      border-radius: 7px;
      border: 1px solid var(--border);
      background: var(--card);
      cursor: pointer;
      color: var(--text);
      transition: background .15s;
    }

    .budget-btn:hover {
      background: var(--bg);
    }


    /* ── Button loading spinner ── */
    .btn-spin {
      opacity: .72;
      cursor: not-allowed !important;
      pointer-events: none;
    }

    .btn-spin::after {
      content: '';
      display: inline-block;
      width: 12px;
      height: 12px;
      border-radius: 50%;
      border: 2px solid rgba(255, 255, 255, .35);
      border-top-color: #fff;
      animation: spin .65s linear infinite;
      margin-left: 7px;
      vertical-align: middle;
    }

    .btn-spin.btn-secondary::after,
    .btn-spin.btn-ghost::after {
      border-color: rgba(0, 0, 0, .15);
      border-top-color: var(--text);
    }

    @keyframes spin {
      to {
        transform: rotate(360deg);
      }
    }

    /* ── Print / Export ── */
    .export-btn {
      padding: 7px 14px;
      border: 1px solid var(--border);
      background: var(--card);
      border-radius: 8px;
      cursor: pointer;
      font-size: 12px;
      font-weight: 600;
      color: var(--text);
      display: flex;
      align-items: center;
      gap: 5px;
      transition: background .15s;
    }

    .export-btn:hover {
      background: var(--bg);
    }

    @media print {

      .sidebar,
      .mobile-nav,
      .topbar,
      .bills-filters,
      .dash-filter-bar,
      .actions,
      .btn-ic,
      #btn-add-bill,
      .notif-wrap,
      .theme-btn,
      .alert-strip,
      .export-btn,
      .view-toggle {
        display: none !important;
      }

      body,
      html {
        overflow: visible !important;
        height: auto !important;
      }

      .content,
      .app-shell {
        overflow: visible !important;
        height: auto !important;
      }

      .page {
        display: block !important;
        overflow: visible !important;
        height: auto !important;
      }

      .page:not(.active) {
        display: none !important;
      }

      .page-body {
        overflow: visible !important;
        height: auto !important;
        padding: 0 !important;
      }

      .table-scroll {
        overflow: visible !important;
      }

      table {
        page-break-inside: auto;
      }

      tr {
        page-break-inside: avoid;
      }

      @page {
        margin: 1.5cm;
      }
    }

    *,
    *::before,
    *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html,
    body {
      height: 100%;
      overflow: hidden;
    }

    body {
      font-family: 'Inter', Arial, sans-serif;
      background: var(--bg);
      color: var(--text);
      font-size: 14px;
      display: flex;
    }

    /* ════════════════════════════════════════
       SIDEBAR
    ════════════════════════════════════════ */
    .sidebar {
      width: var(--sidebar-w);
      flex-shrink: 0;
      background: linear-gradient(180deg, #1e1b4b 0%, #312e81 100%);
      display: flex;
      flex-direction: column;
      height: 100vh;
      overflow-y: auto;
    }

    .sidebar-brand {
      padding: 22px 18px 16px;
      border-bottom: 1px solid rgba(255, 255, 255, .1);
    }

    .sidebar-brand .brand-icon {
      width: 40px;
      height: 40px;
      background: rgba(255, 255, 255, .15);
      border-radius: 10px;
      display: grid;
      place-items: center;
      font-size: 20px;
      margin-bottom: 8px;
    }

    .sidebar-brand h2 {
      font-size: 14px;
      font-weight: 700;
      color: #fff;
      line-height: 1.3;
    }

    .sidebar-brand p {
      font-size: 11px;
      color: rgba(255, 255, 255, .5);
      margin-top: 2px;
    }

    .sidebar-section {
      padding: 14px 12px 6px;
      font-size: 10px;
      font-weight: 700;
      color: rgba(255, 255, 255, .3);
      text-transform: uppercase;
      letter-spacing: .08em;
    }

    .nav-item {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 5px 10px;
      border-radius: 10px;
      margin: 2px 8px;
      cursor: pointer;
      font-size: 13px;
      font-weight: 500;
      color: rgba(255, 255, 255, .6);
      transition: background .15s, color .15s, transform .1s;
      border: none;
      background: transparent;
      width: calc(100% - 16px);
      font-family: inherit;
      text-align: left;
    }

    .nav-item:hover {
      background: rgba(255, 255, 255, .07);
      color: #fff;
    }

    .nav-item:active {
      transform: scale(.97);
    }

    .nav-item.active {
      background: rgba(255, 255, 255, .1);
      color: #fff;
      font-weight: 600;
    }

    .nav-item .nav-icon {
      width: 34px;
      height: 34px;
      border-radius: 9px;
      background: rgba(255, 255, 255, .08);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 14px;
      flex-shrink: 0;
      transition: background .2s, box-shadow .2s, color .2s;
      color: rgba(255, 255, 255, .6);
    }

    .nav-item:hover .nav-icon {
      background: rgba(255, 255, 255, .14);
      color: #fff;
    }

    .nav-item.active .nav-icon {
      background: #fff;
      color: #4f46e5;
      box-shadow: 0 4px 14px rgba(0, 0, 0, .25);
    }

    .nav-item .nav-badge {
      margin-left: auto;
      background: var(--danger);
      color: #fff;
      border-radius: 99px;
      padding: 1px 7px;
      font-size: 10px;
      font-weight: 700;
      display: none;
    }

    .nav-item .nav-badge.show {
      display: block;
    }

    /* ── Expandable nav group ── */
    .nav-group {
      margin: 2px 8px;
    }

    .nav-group-header {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 5px 10px;
      border-radius: 10px;
      cursor: pointer;
      font-size: 13px;
      font-weight: 500;
      color: rgba(255, 255, 255, .6);
      transition: background .15s, color .15s, transform .1s;
      border: none;
      background: transparent;
      width: 100%;
      font-family: inherit;
      text-align: left;
    }

    .nav-group-header:hover {
      background: rgba(255, 255, 255, .07);
      color: #fff;
    }

    .nav-group-header:active {
      transform: scale(.97);
    }

    .nav-group-header .nav-icon {
      width: 34px;
      height: 34px;
      border-radius: 9px;
      background: rgba(255, 255, 255, .08);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 14px;
      flex-shrink: 0;
      transition: background .2s, color .2s;
      color: rgba(255, 255, 255, .6);
    }

    .nav-group-header:hover .nav-icon {
      background: rgba(255, 255, 255, .14);
      color: #fff;
    }

    .nav-group.open .nav-group-header .nav-icon {
      background: rgba(255, 255, 255, .18);
      color: #fff;
    }

    .nav-group-arrow {
      margin-left: auto;
      font-size: 10px;
      transition: transform .25s ease;
      color: rgba(255, 255, 255, .4);
    }

    .nav-group.open .nav-group-arrow {
      transform: rotate(90deg);
    }

    .nav-group-children {
      max-height: 0;
      overflow: hidden;
      padding-left: 10px;
      transition: max-height .3s ease;
    }

    .nav-group.open .nav-group-children {
      max-height: 200px;
    }

    .nav-sub-item {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 5px 10px;
      border-radius: 9px;
      margin: 1px 0;
      cursor: pointer;
      font-size: 12px;
      font-weight: 500;
      color: rgba(255, 255, 255, .55);
      transition: background .15s, color .15s, transform .1s;
      border: none;
      background: transparent;
      width: 100%;
      font-family: inherit;
      text-align: left;
    }

    .nav-sub-item:hover {
      background: rgba(255, 255, 255, .07);
      color: #fff;
    }

    .nav-sub-item:active {
      transform: scale(.97);
    }

    .nav-sub-item.active {
      background: rgba(255, 255, 255, .1);
      color: #fff;
      font-weight: 600;
    }

    .nav-sub-item .nav-icon {
      width: 28px;
      height: 28px;
      border-radius: 7px;
      background: rgba(255, 255, 255, .07);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 12px;
      flex-shrink: 0;
      transition: background .2s, box-shadow .2s, color .2s;
      color: rgba(255, 255, 255, .55);
    }

    .nav-sub-item:hover .nav-icon {
      background: rgba(255, 255, 255, .13);
      color: #fff;
    }

    .nav-sub-item.active .nav-icon {
      background: rgba(255, 255, 255, .9);
      color: #4f46e5;
      box-shadow: 0 3px 10px rgba(0, 0, 0, .2);
    }

    .nav-sub-item .nav-badge {
      margin-left: auto;
      background: var(--danger);
      color: #fff;
      border-radius: 99px;
      padding: 1px 7px;
      font-size: 10px;
      font-weight: 700;
      display: none;
    }

    .nav-sub-item .nav-badge.show {
      display: block;
    }

    .sidebar-footer {
      margin-top: auto;
      padding: 14px 12px;
      border-top: 1px solid rgba(255, 255, 255, .1);
      font-size: 11px;
      color: rgba(255, 255, 255, .35);
      text-align: center;
    }

    /* ════════════════════════════════════════
       MAIN CONTENT
    ════════════════════════════════════════ */
    .content {
      flex: 1;
      display: flex;
      flex-direction: column;
      height: 100vh;
      overflow: hidden;
      min-width: 0;
    }

    /* ── Topbar ── */
    .topbar {
      background: var(--card);
      border-bottom: 1px solid var(--border);
      padding: 13px 24px;
      display: flex;
      align-items: center;
      gap: 12px;
      flex-shrink: 0;
      box-shadow: 0 1px 4px rgba(0, 0, 0, .06);
    }

    .topbar-title {
      font-size: 16px;
      font-weight: 700;
      color: var(--text);
    }

    .topbar-sub {
      font-size: 12px;
      color: var(--muted);
      margin-left: 4px;
    }

    .topbar-right {
      margin-left: auto;
      display: flex;
      align-items: center;
      gap: 10px;
    }

    #top-date {
      font-size: 12px;
      color: var(--muted);
    }

    #btn-add-bill {
      display: flex;
      align-items: center;
      gap: 6px;
      padding: 8px 18px;
      background: var(--primary);
      color: #fff;
      border: none;
      border-radius: 8px;
      cursor: pointer;
      font-size: 13px;
      font-weight: 600;
      font-family: inherit;
      transition: background .2s;
    }

    #btn-add-bill:hover {
      background: var(--primary-d);
    }

    /* ── Notification Bell ── */
    .notif-wrap {
      position: relative;
    }

    .notif-btn {
      position: relative;
      background: var(--bg);
      border: 1px solid var(--border);
      border-radius: 10px;
      width: 38px;
      height: 38px;
      cursor: pointer;
      font-size: 18px;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: background .15s;
    }

    .notif-btn:hover {
      background: var(--border);
    }

    .notif-badge {
      position: absolute;
      top: -5px;
      right: -5px;
      background: #ef4444;
      color: #fff;
      font-size: 10px;
      font-weight: 700;
      min-width: 18px;
      height: 18px;
      border-radius: 99px;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 0 4px;
      pointer-events: none;
      display: none;
    }

    .notif-panel {
      position: absolute;
      top: calc(100% + 10px);
      right: 0;
      width: 340px;
      max-height: 480px;
      overflow-y: auto;
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 14px;
      box-shadow: 0 8px 32px rgba(0, 0, 0, .15);
      z-index: 200;
      display: none;
      flex-direction: column;
      animation: fdIn .15s;
    }

    .notif-panel.open {
      display: flex;
    }

    .notif-panel-head {
      padding: 14px 16px 10px;
      border-bottom: 1px solid var(--border);
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .notif-panel-head h3 {
      font-size: 14px;
      font-weight: 700;
      margin: 0;
    }

    .notif-section-label {
      padding: 8px 16px 4px;
      font-size: 11px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: .05em;
      color: var(--muted);
    }

    .notif-item {
      display: flex;
      align-items: flex-start;
      gap: 10px;
      padding: 10px 16px;
      border-bottom: 1px solid var(--border);
      cursor: default;
      transition: background .1s;
    }

    .notif-item:hover {
      background: var(--bg);
    }

    .notif-item:last-child {
      border-bottom: none;
    }

    .notif-icon {
      font-size: 18px;
      flex-shrink: 0;
      margin-top: 1px;
    }

    .notif-body {
      flex: 1;
      min-width: 0;
    }

    .notif-name {
      font-size: 13px;
      font-weight: 600;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .notif-meta {
      font-size: 11px;
      color: var(--muted);
      margin-top: 2px;
    }

    .notif-amt {
      font-size: 13px;
      font-weight: 700;
      flex-shrink: 0;
    }

    .notif-empty {
      padding: 24px 16px;
      text-align: center;
      color: var(--muted);
      font-size: 13px;
    }

    /* ── Pages ── */
    @keyframes pageIn {
      from {
        opacity: 0;
        transform: translateY(10px);
      }

      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .page {
      display: none;
      flex: 1;
      overflow: hidden;
      flex-direction: column;
    }

    .page.active {
      display: flex;
      animation: pageIn .22s ease;
    }

    .page-body {
      flex: 1;
      overflow-y: auto;
      padding: 20px 24px;
      display: flex;
      flex-direction: column;
      gap: 16px;
    }

    /* ════════════════════════════════════════
       DASHBOARD PAGE
    ════════════════════════════════════════ */

    /* Hero KPI row */
    .hero-row {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 14px;
      flex-shrink: 0;
    }

    .hero-card {
      background: var(--card);
      border-radius: var(--radius);
      padding: 18px 20px;
      box-shadow: var(--shadow);
      border-left: 4px solid var(--border);
      transition: transform .2s, box-shadow .2s;
    }

    .hero-card:hover {
      transform: translateY(-2px);
      box-shadow: var(--shadow-lg);
    }

    .hero-card.hc-total {
      border-color: var(--primary);
    }

    .hero-card.hc-paid {
      border-color: var(--success);
    }

    .hero-card.hc-remain {
      border-color: var(--warning);
    }

    .hc-label {
      font-size: 11px;
      font-weight: 600;
      color: var(--muted);
      text-transform: uppercase;
      letter-spacing: .06em;
      margin-bottom: 4px;
    }

    .hc-value {
      font-size: 30px;
      font-weight: 800;
      color: var(--text);
      line-height: 1.1;
    }

    .hc-sub {
      font-size: 12px;
      color: var(--muted);
      margin-top: 3px;
    }

    .hc-sub strong {
      color: var(--text);
    }

    .hc-bar-wrap {
      margin-top: 8px;
      background: var(--bg);
      border-radius: 99px;
      height: 5px;
    }

    .hc-bar {
      height: 100%;
      border-radius: 99px;
      background: var(--success);
      transition: width .6s;
    }

    /* Progress strip */
    .progress-strip {
      background: var(--card);
      border-radius: var(--radius);
      padding: 12px 20px;
      box-shadow: var(--shadow);
      display: flex;
      align-items: center;
      gap: 14px;
      flex-shrink: 0;
    }

    .ps-label {
      font-size: 12px;
      font-weight: 700;
      color: var(--text);
      white-space: nowrap;
    }

    .ps-bar-wrap {
      flex: 1;
      background: var(--bg);
      border-radius: 99px;
      height: 10px;
      overflow: hidden;
    }

    .ps-bar {
      height: 100%;
      border-radius: 99px;
      background: linear-gradient(90deg, #22c55e, #16a34a);
      transition: width .6s;
    }

    .ps-pct {
      font-size: 15px;
      font-weight: 800;
      color: var(--success);
      white-space: nowrap;
    }

    .ps-text {
      font-size: 12px;
      color: var(--muted);
      white-space: nowrap;
    }

    /* Stat cards row */
    .stat-row {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 14px;
      flex-shrink: 0;
    }

    .stat-card {
      background: var(--card);
      border-radius: var(--radius);
      padding: 14px 16px;
      box-shadow: var(--shadow);
      display: flex;
      align-items: center;
      gap: 12px;
      transition: transform .2s, box-shadow .2s;
    }

    .stat-card:hover {
      transform: translateY(-2px);
      box-shadow: var(--shadow-lg);
    }

    .sc-icon {
      width: 40px;
      height: 40px;
      border-radius: 10px;
      display: grid;
      place-items: center;
      font-size: 18px;
      flex-shrink: 0;
    }

    .sc-overdue .sc-icon {
      background: #fef2f2;
    }

    .sc-week .sc-icon {
      background: #fff7ed;
    }

    .sc-today .sc-icon {
      background: #fefce8;
    }

    .sc-month .sc-icon {
      background: #f0f9ff;
    }

    .sc-info {
      min-width: 0;
      flex: 1;
    }

    .sc-label {
      font-size: 10px;
      font-weight: 600;
      color: var(--muted);
      text-transform: uppercase;
      letter-spacing: .05em;
    }

    .sc-value {
      font-size: 22px;
      font-weight: 700;
      color: var(--text);
    }

    .sc-sub {
      font-size: 11px;
      color: var(--muted);
    }

    .sc-badge {
      padding: 2px 8px;
      border-radius: 99px;
      font-size: 10px;
      font-weight: 700;
      white-space: nowrap;
    }

    .sc-overdue .sc-badge {
      background: #fee2e2;
      color: #991b1b;
    }

    .sc-week .sc-badge {
      background: #ffedd5;
      color: #9a3412;
    }

    .sc-today .sc-badge {
      background: #fef9c3;
      color: #854d0e;
    }

    .sc-month .sc-badge {
      background: #dbeafe;
      color: #1e40af;
    }

    .sc-pulse {
      animation: pulse 1.4s infinite;
    }

    @keyframes pulse {

      0%,
      100% {
        opacity: 1
      }

      50% {
        opacity: .4
      }
    }

    /* Alert strips */
    .alert-strip {
      border-radius: var(--radius);
      padding: 11px 16px;
      display: none;
      align-items: flex-start;
      gap: 12px;
      box-shadow: var(--shadow);
      flex-shrink: 0;
    }

    .alert-strip.visible {
      display: flex;
    }

    .a-danger {
      background: #fef2f2;
      border: 1px solid #fecaca;
    }

    .a-warn {
      background: #fffbeb;
      border: 1px solid #fde68a;
    }

    .alert-icon {
      font-size: 18px;
      flex-shrink: 0;
      padding-top: 1px;
    }

    .alert-body {
      flex: 1;
      min-width: 0;
    }

    .alert-title {
      font-size: 12px;
      font-weight: 700;
      margin-bottom: 5px;
    }

    .a-danger .alert-title {
      color: #991b1b;
    }

    .a-warn .alert-title {
      color: #92400e;
    }

    .alert-pills {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
    }

    .alert-pill {
      padding: 3px 10px;
      border-radius: 99px;
      font-size: 11px;
      font-weight: 600;
    }

    .a-danger .alert-pill {
      background: #fee2e2;
      color: #7f1d1d;
    }

    .a-warn .alert-pill {
      background: #fde68a;
      color: #78350f;
    }

    /* Bottom row: upcoming + recent */
    .bottom-row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 14px;
      flex: 1;
      min-height: 0;
    }

    .mini-panel {
      background: var(--card);
      border-radius: var(--radius);
      box-shadow: var(--shadow);
      display: flex;
      flex-direction: column;
      overflow: hidden;
      min-height: 0;
    }

    .mini-panel-head {
      padding: 13px 16px;
      border-bottom: 1px solid var(--border);
      font-size: 13px;
      font-weight: 700;
      color: var(--text);
      display: flex;
      align-items: center;
      gap: 8px;
      flex-shrink: 0;
    }

    .mini-panel-head .mp-sub {
      font-size: 11px;
      font-weight: 400;
      color: var(--muted);
      margin-left: auto;
    }

    .mini-panel-body {
      flex: 1;
      overflow-y: auto;
    }

    .mini-row {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 10px 16px;
      border-bottom: 1px solid var(--border);
      transition: background .1s;
    }

    .mini-row:last-child {
      border-bottom: none;
    }

    .mini-row:hover {
      background: #f8fafc;
    }

    .mini-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      flex-shrink: 0;
    }

    .dot-overdue {
      background: var(--danger);
    }

    .dot-soon {
      background: var(--warning);
    }

    .dot-upcoming {
      background: var(--success);
    }

    .dot-paid {
      background: var(--success);
    }

    .mini-info {
      flex: 1;
      min-width: 0;
    }

    .mini-name {
      font-weight: 600;
      font-size: 13px;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .mini-meta {
      font-size: 11px;
      color: var(--muted);
      margin-top: 1px;
    }

    .mini-amount {
      font-weight: 700;
      font-size: 13px;
      white-space: nowrap;
    }

    .mini-badge {
      font-size: 10px;
      font-weight: 700;
      padding: 2px 8px;
      border-radius: 99px;
      white-space: nowrap;
    }

    .mb-overdue {
      background: #fee2e2;
      color: #991b1b;
    }

    .mb-soon {
      background: #ffedd5;
      color: #9a3412;
    }

    .mb-today {
      background: #fef9c3;
      color: #854d0e;
    }

    .mb-upcoming {
      background: #dcfce7;
      color: #166534;
    }

    .mb-paid {
      background: #dcfce7;
      color: #166534;
    }

    .mini-empty {
      text-align: center;
      padding: 30px;
      color: var(--muted);
      font-size: 13px;
    }

    /* ════════════════════════════════════════
       BILLS PAGE
    ════════════════════════════════════════ */
    .bills-body {
      flex: 1;
      overflow: hidden;
      display: flex;
      flex-direction: column;
    }

    .bills-filters {
      padding: 12px 24px;
      border-bottom: 1px solid var(--border);
      display: flex;
      align-items: center;
      gap: 10px;
      flex-wrap: wrap;
      flex-shrink: 0;
      background: var(--card);
    }

    .tabs {
      display: flex;
      gap: 4px;
      background: var(--bg);
      border-radius: 8px;
      padding: 3px;
    }

    .tab {
      padding: 6px 14px;
      border-radius: 6px;
      border: none;
      background: transparent;
      cursor: pointer;
      font-size: 13px;
      font-weight: 500;
      color: var(--muted);
      transition: all .15s;
      font-family: inherit;
    }

    .tab.active {
      background: var(--primary);
      color: #fff;
      box-shadow: 0 1px 4px rgba(99, 102, 241, .35);
      font-weight: 700;
    }

    .tab[data-filter="Unpaid"].active {
      background: #f59e0b;
      box-shadow: 0 1px 4px rgba(245, 158, 11, .35);
    }

    .tab[data-filter="Paid"].active {
      background: #22c55e;
      box-shadow: 0 1px 4px rgba(34, 197, 94, .35);
    }

    .tab[data-filter="Overdue"].active {
      background: #ef4444;
      box-shadow: 0 1px 4px rgba(239, 68, 68, .35);
    }

    .f-spacer {
      flex: 1;
    }

    .filter-select {
      padding: 7px 10px;
      border: 1px solid var(--border);
      border-radius: 8px;
      font-size: 13px;
      font-family: inherit;
      color: var(--text);
      background: var(--card);
      outline: none;
      cursor: pointer;
    }

    .filter-select:focus {
      border-color: var(--primary);
    }

    .search-wrap {
      position: relative;
    }

    .search-wrap .si {
      position: absolute;
      left: 10px;
      top: 50%;
      transform: translateY(-50%);
      font-size: 13px;
      pointer-events: none;
    }

    .search-wrap input {
      padding: 7px 10px 7px 30px;
      border: 1px solid var(--border);
      border-radius: 8px;
      font-size: 13px;
      font-family: inherit;
      outline: none;
      width: 200px;
    }

    .search-wrap input:focus {
      border-color: var(--primary);
    }

    #row-count {
      font-size: 12px;
      color: var(--muted);
      white-space: nowrap;
    }

    .table-scroll {
      flex: 1;
      overflow: auto;
    }

    table {
      width: 100%;
      border-collapse: collapse;
    }

    thead th {
      padding: 10px 14px;
      text-align: left;
      font-size: 11px;
      font-weight: 700;
      color: var(--muted);
      text-transform: uppercase;
      letter-spacing: .05em;
      background: #f8fafc;
      border-bottom: 1px solid var(--border);
      cursor: pointer;
      user-select: none;
      white-space: nowrap;
      position: sticky;
      top: 0;
      z-index: 1;
    }

    thead th:hover {
      color: var(--primary);
    }

    thead th.no-sort {
      cursor: default;
    }

    thead th.no-sort:hover {
      color: var(--muted);
    }

    tbody tr {
      transition: background .1s;
    }

    tbody tr:hover td {
      background: #f8fafc !important;
    }

    tbody td {
      padding: 10px 14px;
      border-bottom: 1px solid var(--border);
      vertical-align: middle;
    }

    tbody tr:last-child td {
      border-bottom: none;
    }

    tbody tr.row-overdue td:first-child {
      box-shadow: inset 3px 0 0 var(--danger);
    }

    tbody tr.row-due-soon td:first-child {
      box-shadow: inset 3px 0 0 var(--warning);
    }

    tbody tr.row-paid td:first-child {
      box-shadow: inset 3px 0 0 var(--success);
    }

    tbody tr.row-overdue {
      background: #fff8f8;
    }

    tbody tr.row-due-soon {
      background: #fffdf0;
    }

    .bill-name {
      font-weight: 600;
    }

    .bill-id {
      font-size: 11px;
      color: var(--muted);
    }

    .cat-badge {
      display: inline-block;
      padding: 2px 9px;
      background: #ede9fe;
      color: #5b21b6;
      border-radius: 99px;
      font-size: 11px;
      font-weight: 600;
    }

    .amount {
      font-weight: 700;
      font-size: 14px;
    }

    .date-cell {
      white-space: nowrap;
    }

    .date-main {
      font-weight: 500;
    }

    .date-tag {
      display: inline-block;
      margin-top: 2px;
      padding: 1px 7px;
      border-radius: 99px;
      font-size: 10px;
      font-weight: 700;
    }

    .dt-overdue {
      background: #fecaca;
      color: #991b1b;
    }

    .dt-today {
      background: #fde68a;
      color: #92400e;
    }

    .dt-soon {
      background: #fed7aa;
      color: #9a3412;
    }

    .dt-upcoming {
      background: #d1fae5;
      color: #065f46;
    }

    .st-badge {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      padding: 3px 10px;
      border-radius: 99px;
      font-size: 11px;
      font-weight: 700;
    }

    .st-badge::before {
      content: '●';
      font-size: 7px;
    }

    .st-paid {
      background: #dcfce7;
      color: #166534;
    }

    .st-unpaid {
      background: #ffedd5;
      color: #9a3412;
    }

    .st-overdue {
      background: #fee2e2;
      color: #991b1b;
    }

    .muted-cell {
      color: var(--muted);
      font-size: 12px;
    }

    .actions {
      display: flex;
      gap: 5px;
    }

    .btn-ic {
      width: 30px;
      height: 30px;
      border-radius: 7px;
      border: none;
      cursor: pointer;
      display: grid;
      place-items: center;
      font-size: 13px;
      transition: all .15s;
    }

    .bi-pay {
      background: #dcfce7;
      color: #166534;
    }

    .bi-pay:hover {
      background: #22c55e;
      color: #fff;
    }

    .bi-edit {
      background: #ede9fe;
      color: #5b21b6;
    }

    .bi-edit:hover {
      background: var(--primary);
      color: #fff;
    }

    .bi-del {
      background: #fee2e2;
      color: #991b1b;
    }

    .bi-del:hover {
      background: var(--danger);
      color: #fff;
    }

    .empty-state {
      text-align: center;
      padding: 60px 20px;
    }

    .empty-state .ei {
      font-size: 48px;
      margin-bottom: 12px;
      opacity: .35;
    }

    .empty-state h3 {
      font-size: 16px;
      color: var(--muted);
      margin-bottom: 6px;
    }

    .empty-state p {
      font-size: 13px;
      color: var(--muted);
    }

    /* ════════════════════════════════════════
       MODALS
    ════════════════════════════════════════ */
    .overlay {
      display: none;
      position: fixed;
      inset: 0;
      background: rgba(15, 23, 42, .55);
      z-index: 100;
      align-items: flex-end;
      justify-content: center;
      backdrop-filter: blur(4px);
    }

    .overlay.open {
      display: flex;
      animation: fdIn .2s;
    }

    @keyframes fdIn {
      from {
        opacity: 0
      }

      to {
        opacity: 1
      }
    }

    .modal {
      background: var(--card);
      border-radius: 20px 20px 0 0;
      padding: 24px 26px 30px;
      width: 100%;
      max-width: 540px;
      max-height: 90vh;
      overflow-y: auto;
      box-shadow: 0 -8px 40px rgba(0, 0, 0, .2);
      animation: slUp .25s ease-out;
    }

    @keyframes slUp {
      from {
        transform: translateY(60px);
        opacity: 0
      }

      to {
        transform: translateY(0);
        opacity: 1
      }
    }

    .modal-drag {
      width: 36px;
      height: 4px;
      background: var(--border);
      border-radius: 99px;
      margin: 0 auto 18px;
    }

    .modal h2 {
      font-size: 17px;
      font-weight: 700;
      margin-bottom: 18px;
    }

    .form-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px;
    }

    .form-grid .full {
      grid-column: 1/-1;
    }

    .field {
      display: flex;
      flex-direction: column;
      gap: 4px;
    }

    .field label {
      font-size: 11px;
      font-weight: 700;
      color: var(--muted);
      text-transform: uppercase;
      letter-spacing: .04em;
    }

    .field input,
    .field select {
      padding: 9px 11px;
      border: 1.5px solid var(--border);
      border-radius: 8px;
      font-size: 14px;
      font-family: inherit;
      color: var(--text);
      outline: none;
      transition: border-color .2s, box-shadow .2s;
    }

    .field input:focus,
    .field select:focus {
      border-color: var(--primary);
      box-shadow: 0 0 0 3px rgba(99, 102, 241, .1);
    }

    .modal-footer {
      display: flex;
      gap: 10px;
      margin-top: 22px;
    }

    .btn-primary {
      flex: 1;
      padding: 11px;
      background: linear-gradient(135deg, #6366f1, #4f46e5);
      color: #fff;
      border: none;
      border-radius: 9px;
      cursor: pointer;
      font-size: 14px;
      font-weight: 700;
      font-family: inherit;
      transition: opacity .2s;
    }

    .btn-primary:hover {
      opacity: .88;
    }

    .btn-secondary {
      padding: 11px 18px;
      background: var(--bg);
      color: var(--muted);
      border: 1.5px solid var(--border);
      border-radius: 9px;
      cursor: pointer;
      font-size: 14px;
      font-weight: 600;
      font-family: inherit;
    }

    .btn-secondary:hover {
      background: var(--border);
    }

    #confirm-overlay {
      display: none;
      position: fixed;
      inset: 0;
      background: rgba(15, 23, 42, .55);
      z-index: 200;
      align-items: center;
      justify-content: center;
      backdrop-filter: blur(4px);
    }

    #confirm-overlay.open {
      display: flex;
      animation: fdIn .2s;
    }

    .confirm-box {
      background: var(--card);
      border-radius: 18px;
      padding: 30px 26px;
      width: 330px;
      text-align: center;
      box-shadow: var(--shadow-lg);
      animation: ppIn .2s ease-out;
    }

    @keyframes ppIn {
      from {
        transform: scale(.9);
        opacity: 0
      }

      to {
        transform: scale(1);
        opacity: 1
      }
    }

    .confirm-box .ci {
      font-size: 42px;
      margin-bottom: 12px;
    }

    .confirm-box h3 {
      font-size: 16px;
      font-weight: 700;
      margin-bottom: 6px;
    }

    .confirm-box p {
      font-size: 13px;
      color: var(--muted);
      margin-bottom: 20px;
    }

    .confirm-actions {
      display: flex;
      gap: 10px;
    }

    .btn-danger {
      flex: 1;
      padding: 10px;
      background: var(--danger);
      color: #fff;
      border: none;
      border-radius: 8px;
      cursor: pointer;
      font-size: 14px;
      font-weight: 700;
      font-family: inherit;
    }

    .btn-ghost {
      flex: 1;
      padding: 10px;
      background: var(--bg);
      color: var(--text);
      border: 1.5px solid var(--border);
      border-radius: 8px;
      cursor: pointer;
      font-size: 14px;
      font-weight: 600;
      font-family: inherit;
    }

    #toast {
      position: fixed;
      bottom: 24px;
      left: 50%;
      transform: translateX(-50%) translateY(16px);
      background: #1e293b;
      color: #fff;
      padding: 11px 22px;
      border-radius: 10px;
      font-size: 13px;
      font-weight: 500;
      opacity: 0;
      transition: all .3s;
      pointer-events: none;
      z-index: 999;
      white-space: nowrap;
      box-shadow: var(--shadow-lg);
    }

    #toast.show {
      opacity: 1;
      transform: translateX(-50%) translateY(0);
    }

    /* ════════════════════════════════════════
       DASHBOARD FILTER BAR
    ════════════════════════════════════════ */
    .dash-filter-bar {
      padding: 10px 24px;
      border-bottom: 1px solid var(--border);
      display: flex;
      align-items: center;
      gap: 10px;
      flex-wrap: wrap;
      flex-shrink: 0;
      background: var(--card);
    }

    .df-label {
      font-size: 12px;
      font-weight: 600;
      color: var(--muted);
      white-space: nowrap;
    }

    #dash-filter-label {
      font-size: 11px;
      color: var(--primary);
      font-weight: 600;
      margin-left: auto;
      white-space: nowrap;
    }

    /* ════════════════════════════════════════
       ATTACHMENT
    ════════════════════════════════════════ */
    .bi-att {
      background: #e0f2fe;
      color: #0369a1;
    }

    .bi-att:hover {
      background: #0ea5e9;
      color: #fff;
    }

    .bi-att-view {
      background: #dcfce7;
      color: #166534;
    }

    .bi-att-view:hover {
      background: #22c55e;
      color: #fff;
    }

    .att-dot {
      width: 7px;
      height: 7px;
      background: var(--success);
      border-radius: 50%;
      display: inline-block;
      vertical-align: middle;
      margin-left: 2px;
    }

    .att-empty {
      padding: 30px;
      color: var(--muted);
      font-size: 30px;
    }

    /* ════════════════════════════════════════
       PROOF LIGHTBOX
    ════════════════════════════════════════ */
    #lightbox-overlay {
      display: none;
      position: fixed;
      inset: 0;
      z-index: 300;
      background: rgba(0, 0, 0, .93);
      flex-direction: column;
      animation: fdIn .2s;
    }

    #lightbox-overlay.open {
      display: flex;
    }

    .lb-toolbar {
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 12px 16px;
      flex-shrink: 0;
      background: rgba(0, 0, 0, .45);
      backdrop-filter: blur(8px);
      border-bottom: 1px solid rgba(255, 255, 255, .08);
    }

    .lb-title {
      flex: 1;
      color: rgba(255, 255, 255, .85);
      font-size: 13px;
      font-weight: 600;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .lb-btn {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      padding: 7px 14px;
      border-radius: 8px;
      border: none;
      cursor: pointer;
      font-size: 12px;
      font-weight: 600;
      font-family: inherit;
      transition: all .15s;
      white-space: nowrap;
      text-decoration: none;
    }

    .lb-close {
      background: rgba(255, 255, 255, .12);
      color: rgba(255, 255, 255, .9);
    }

    .lb-close:hover {
      background: rgba(255, 255, 255, .22);
    }

    .lb-download {
      background: var(--primary);
      color: #fff;
    }

    .lb-download:hover {
      background: var(--primary-d);
    }

    .lb-del {
      background: rgba(239, 68, 68, .75);
      color: #fff;
    }

    .lb-del:hover {
      background: var(--danger);
    }

    .lb-image-wrap {
      flex: 1;
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: auto;
      padding: 20px;
      cursor: zoom-in;
    }

    .lb-image-wrap img {
      max-width: 100%;
      max-height: 100%;
      object-fit: contain;
      border-radius: 6px;
      box-shadow: 0 8px 40px rgba(0, 0, 0, .6);
      user-select: none;
      transition: transform .2s;
      display: block;
    }

    .lb-image-wrap.zoomed {
      cursor: zoom-out;
      align-items: flex-start;
      justify-content: flex-start;
    }

    .lb-image-wrap.zoomed img {
      max-width: none;
      max-height: none;
      width: auto;
      height: auto;
      transform: scale(1);
    }

    .lb-pdf-wrap {
      flex: 1;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .lb-pdf-link {
      color: #fff;
      font-size: 15px;
      font-weight: 600;
      text-decoration: none;
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 16px 28px;
      background: rgba(255, 255, 255, .1);
      border-radius: 12px;
    }

    .lb-pdf-link:hover {
      background: rgba(255, 255, 255, .2);
    }

    /* ════════════════════════════════════════
       LOANS PAGE
    ════════════════════════════════════════ */
    .loans-kpi {
      padding: 16px 24px;
      flex-shrink: 0;
      background: var(--bg);
      border-bottom: 1px solid var(--border);
    }

    /* Payment history list */
    .pmt-list {
      border: 1px solid var(--border);
      border-radius: var(--radius);
      overflow: hidden;
      max-height: 260px;
      overflow-y: auto;
    }

    .pmt-row {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 10px 14px;
      border-bottom: 1px solid var(--border);
    }

    .pmt-row:last-child {
      border-bottom: none;
    }

    .pmt-date {
      font-size: 12px;
      color: var(--muted);
      white-space: nowrap;
      flex-shrink: 0;
    }

    .pmt-amt {
      font-weight: 700;
      font-size: 14px;
      color: var(--success);
      white-space: nowrap;
      flex-shrink: 0;
    }

    .pmt-note {
      flex: 1;
      font-size: 12px;
      color: var(--muted);
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .pmt-empty {
      text-align: center;
      padding: 20px 16px;
      color: var(--muted);
      font-size: 13px;
    }

    @media (max-width: 640px) {
      .loans-kpi {
        padding: 12px;
      }
    }

    /* ════════════════════════════════════════
       MOBILE BOTTOM NAV
    ════════════════════════════════════════ */
    .mobile-nav {
      display: none;
      position: fixed;
      bottom: 0;
      left: 0;
      right: 0;
      z-index: 50;
      background: linear-gradient(0deg, #1e1b4b 0%, #312e81 100%);
      justify-content: space-around;
      align-items: center;
      padding: 6px 0 max(8px, env(safe-area-inset-bottom));
      box-shadow: 0 -2px 20px rgba(0, 0, 0, .3);
    }

    .mn-item {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 4px;
      padding: 6px 24px;
      border: none;
      background: transparent;
      cursor: pointer;
      color: rgba(255, 255, 255, .45);
      transition: color .15s, transform .1s;
      font-family: inherit;
      position: relative;
    }

    .mn-item:active {
      transform: scale(.93);
    }

    .mn-item.active {
      color: #fff;
    }

    .mn-icon {
      width: 38px;
      height: 38px;
      border-radius: 10px;
      background: rgba(255, 255, 255, .07);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 16px;
      transition: background .2s, box-shadow .2s, color .2s;
    }

    .mn-item:hover .mn-icon {
      background: rgba(255, 255, 255, .13);
    }

    .mn-item.active .mn-icon {
      background: #fff;
      color: #4f46e5;
      box-shadow: 0 4px 14px rgba(0, 0, 0, .25);
    }

    .mn-label {
      font-size: 10px;
      font-weight: 600;
      letter-spacing: .02em;
    }

    .mn-badge {
      position: absolute;
      top: 0;
      right: 18px;
      background: var(--danger);
      color: #fff;
      border-radius: 99px;
      padding: 1px 5px;
      font-size: 9px;
      font-weight: 700;
      display: none;
    }

    .mn-badge.show {
      display: block;
    }

    /* ════════════════════════════════════════
       RESPONSIVE
    ════════════════════════════════════════ */

    /* ── Laptop ≤1200px ── */
    @media (max-width: 1200px) {
      .stat-row {
        grid-template-columns: repeat(2, 1fr);
      }

      .charts-row {
        grid-template-columns: 1fr;
      }

      /* bottom-row stacks; give panels a fixed height so they don't collapse */
      .bottom-row {
        grid-template-columns: 1fr;
        flex: unset;
      }

      .mini-panel {
        height: 280px;
      }
    }

    /* ── Tablet ≤900px ── */
    @media (max-width: 900px) {
      :root {
        --sidebar-w: 180px;
      }

      .hero-row {
        grid-template-columns: repeat(2, 1fr);
      }

      #top-date {
        display: none;
      }

      .topbar {
        padding: 11px 16px;
      }

      .page-body {
        padding: 14px 16px;
      }

      .bills-filters {
        padding: 10px 16px;
      }

      .dash-filter-bar {
        padding: 8px 16px;
      }

      .search-wrap input {
        width: 150px;
      }

      /* Hide verbose progress text — percentage stays */
      .ps-text {
        display: none;
      }
    }

    .mobile-logout-btn {
      display: none;
    }

    /* ── Mobile ≤640px ── */
    @media (max-width: 640px) {

      /* Replace sidebar with bottom nav */
      .sidebar {
        display: none;
      }

      .mobile-logout-btn {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 36px;
        height: 36px;
        border-radius: 9px;
        border: 1px solid var(--border);
        background: var(--card);
        color: var(--danger);
        font-size: 15px;
        cursor: pointer;
        flex-shrink: 0;
      }

      .mobile-nav {
        display: flex;
      }

      /* Topbar */
      .topbar {
        padding: 10px 14px;
      }

      .topbar-title {
        font-size: 14px;
      }

      .topbar-sub {
        display: none;
      }

      .btn-text {
        display: none;
      }

      #btn-add-bill {
        padding: 8px 12px;
      }

      /* Hide non-essential topbar items to make room for logout */
      #top-date,
      #btn-help,
      #btn-theme {
        display: none !important;
      }

      /* Page body — extra bottom padding clears the bottom nav bar */
      .page-body {
        padding: 12px 12px 74px;
        gap: 12px;
      }

      .bills-filters {
        padding: 8px 12px;
        row-gap: 8px;
      }

      .dash-filter-bar {
        padding: 8px 12px;
        row-gap: 8px;
        flex-wrap: wrap;
      }

      /* Dashboard grids — all single column */
      .hero-row {
        grid-template-columns: 1fr;
      }

      .stat-row {
        grid-template-columns: repeat(2, 1fr);
      }

      .bottom-row {
        grid-template-columns: 1fr;
        flex: unset;
      }

      .mini-panel {
        height: 220px;
      }

      .hc-value {
        font-size: 22px;
      }

      /* Progress strip — wrap bar to its own line */
      .progress-strip {
        flex-wrap: wrap;
        padding: 10px 14px;
        gap: 8px;
      }

      .ps-bar-wrap {
        width: 100%;
        order: 3;
      }

      .ps-text {
        display: none;
      }

      /* Dashboard filter bar — month + cut tabs wrap cleanly */
      .dash-filter-bar .tabs {
        order: 2;
        width: 100%;
      }

      .dash-filter-bar .tab {
        flex: 1;
        text-align: center;
        padding: 5px 4px;
        font-size: 11px;
      }

      .dash-filter-bar .filter-select {
        flex: 1;
      }

      #dash-filter-label {
        display: none;
      }

      /* Bills filter bar */
      .bills-filters .tabs {
        width: 100%;
      }

      .bills-filters .tab {
        flex: 1;
        text-align: center;
        padding: 5px 4px;
        font-size: 11px;
      }

      .f-spacer {
        display: none;
      }

      .filter-select {
        flex: 1;
        min-width: 0;
        font-size: 12px;
        padding: 6px 7px;
      }

      .search-wrap {
        width: 100%;
      }

      .search-wrap input {
        width: 100%;
      }

      #row-count {
        width: 100%;
        text-align: right;
        font-size: 11px;
      }

      /* Table — let it scroll horizontally, minimum width preserved */
      .table-scroll {
        -webkit-overflow-scrolling: touch;
      }

      .table-scroll table {
        min-width: 680px;
      }

      tbody td,
      thead th {
        padding: 8px 10px;
      }

      /* Form & modals */
      .form-grid {
        grid-template-columns: 1fr;
      }

      .form-grid .full {
        grid-column: 1;
      }

      .modal {
        padding: 20px 16px 30px;
      }

      .confirm-box {
        width: calc(100% - 40px);
        margin: 0 20px;
      }
    }
  </style>
</head>

<body>

  <!-- ════ SIDEBAR ════ -->
  <aside class="sidebar">
    <div class="sidebar-brand" style="text-align:left">
      <!-- <div style="background:#fff;border-radius:12px;padding:6px 10px;display:inline-block;margin-bottom:10px">
        <img src="logos/expense_logo.png" alt="Expense Monitor"
          style="width:70px;height:58px;object-fit:contain;display:block;"
          onerror="this.parentElement.style.display='none'">
      </div> -->
      <h2>Expenses Monitoring</h2>
      <p>Cut-off Bill Tracker</p>
    </div>
    <div class="sidebar-section">Menu</div>
    <button class="nav-item active" data-page="dashboard">
      <span class="nav-icon"><i class="fa-solid fa-gauge-high"></i></span>
      <span>Dashboard</span>
    </button>
    <button class="nav-item" data-page="bills">
      <span class="nav-icon"><i class="fa-solid fa-file-invoice-dollar"></i></span>
      <span>Bills</span>
      <span class="nav-badge" id="nav-overdue-badge">0</span>
    </button>
    <button class="nav-item" data-page="loans">
      <span class="nav-icon"><i class="fa-solid fa-credit-card"></i></span>
      <span>Loans</span>
    </button>
    <div class="nav-group" id="nav-admin-group" style="display:none">
      <button class="nav-group-header" onclick="toggleNavGroup()">
        <span class="nav-icon"><i class="fa-solid fa-sliders"></i></span>
        <span>Management</span>
        <span class="nav-group-arrow">▶</span>
      </button>
      <div class="nav-group-children">
        <button class="nav-sub-item" data-page="users" id="nav-users">
          <span class="nav-icon"><i class="fa-solid fa-users"></i></span>
          <span>Users</span>
          <span class="nav-badge" id="nav-pending-badge">0</span>
        </button>
        <button class="nav-sub-item" data-page="groups" id="nav-groups">
          <span class="nav-icon"><i class="fa-solid fa-people-roof"></i></span>
          <span>Groups</span>
        </button>
      </div>
    </div>
    <div class="sidebar-footer">
      v1.0
      <button onclick="openChangePw()"
        style="display:block;width:100%;margin-top:10px;padding:7px 10px;background:rgba(255,255,255,.08);color:rgba(255,255,255,.6);border:1px solid rgba(255,255,255,.12);border-radius:8px;cursor:pointer;font-size:12px;font-weight:600;font-family:inherit;transition:background .15s"
        onmouseover="this.style.background='rgba(255,255,255,.15)'"
        onmouseout="this.style.background='rgba(255,255,255,.08)'"><i class="fa-solid fa-lock"
          style="margin-right:6px"></i> Change Password</button>
      <button onclick="doLogout()"
        style="display:block;width:100%;margin-top:6px;padding:7px 10px;background:rgba(255,255,255,.1);color:rgba(255,255,255,.65);border:1px solid rgba(255,255,255,.15);border-radius:8px;cursor:pointer;font-size:12px;font-weight:600;font-family:inherit;transition:background .15s"
        onmouseover="this.style.background='rgba(255,255,255,.18)'"
        onmouseout="this.style.background='rgba(255,255,255,.1)'"><i class="fa-solid fa-right-from-bracket"
          style="margin-right:6px"></i> Sign Out</button>
    </div>
  </aside>

  <!-- ════ MOBILE BOTTOM NAV ════ -->
  <nav class="mobile-nav" id="mobile-nav">
    <button class="mn-item active" data-page="dashboard">
      <span class="mn-icon"><i class="fa-solid fa-gauge-high"></i></span>
      <span class="mn-label">Dashboard</span>
    </button>
    <button class="mn-item" data-page="bills">
      <span class="mn-icon"><i class="fa-solid fa-file-invoice-dollar"></i></span>
      <span class="mn-label">Bills</span>
      <span class="mn-badge" id="mn-overdue-badge">0</span>
    </button>
    <button class="mn-item" data-page="loans">
      <span class="mn-icon"><i class="fa-solid fa-credit-card"></i></span>
      <span class="mn-label">Loans</span>
    </button>
    <button class="mn-item" data-page="users" id="mn-users" style="display:none">
      <span class="mn-icon"><i class="fa-solid fa-users"></i></span>
      <span class="mn-label">Users</span>
      <span class="mn-badge" id="mn-pending-badge">0</span>
    </button>
    <button class="mn-item" data-page="groups" id="mn-groups" style="display:none">
      <span class="mn-icon"><i class="fa-solid fa-people-roof"></i></span>
      <span class="mn-label">Groups</span>
    </button>
  </nav>

  <!-- ════ CONTENT ════ -->
  <div class="content">

    <!-- Topbar -->
    <div class="topbar">
      <span class="topbar-title" id="page-title">Dashboard</span>
      <span class="topbar-sub" id="page-sub"></span>
      <div class="topbar-right">
        <!-- Group context pill / switcher -->
        <div id="group-switcher-wrap" style="display:none">
          <!-- Admin: dropdown select -->
          <select id="group-switcher-select" title="Switch active group"
            style="padding:5px 10px;border:1.5px solid var(--border);border-radius:8px;font-size:12px;font-weight:600;font-family:inherit;color:var(--text);background:var(--card);cursor:pointer;outline:none;display:none"
            onchange="switchGroup(this.value)">
          </select>
          <!-- Non-admin: static badge -->
          <span id="group-badge"
            style="display:none;padding:5px 11px;border:1.5px solid var(--border);border-radius:8px;font-size:12px;font-weight:600;color:var(--text);background:var(--card);white-space:nowrap">
          </span>
        </div>
        <span id="top-date"></span>
        <button class="theme-btn" id="btn-help" onclick="openHelp()" title="How to use this app"
          style="font-size:16px">ℹ️</button>
        <button class="theme-btn" id="btn-theme" title="Toggle dark mode">🌙</button>
        <!-- Notification Bell -->
        <div class="notif-wrap">
          <button class="notif-btn" id="btn-bell" title="Notifications">🔔
            <span class="notif-badge" id="notif-badge">0</span>
          </button>
          <div class="notif-panel" id="notif-panel">
            <div class="notif-panel-head">
              <h3>Notifications</h3>
              <span id="notif-count-label" style="font-size:11px;color:var(--muted)"></span>
            </div>
            <div id="notif-body"></div>
          </div>
        </div>
        <button id="btn-add-bill">＋ <span class="btn-text">Add Bill</span></button>
        <button class="mobile-logout-btn" onclick="doLogout()" title="Sign Out">
          <i class="fa-solid fa-right-from-bracket"></i>
        </button>
      </div>
    </div>

    <!-- ════ DASHBOARD PAGE ════ -->
    <div id="page-dashboard" class="page active">

      <!-- Dashboard filter bar -->
      <div class="dash-filter-bar">
        <span class="df-label">📅 Period:</span>
        <select class="filter-select" id="dash-month" style="min-width:140px">
          <option value="">All Months</option>
        </select>
        <div class="tabs">
          <button class="tab active" data-dashcut="">All Cuts</button>
          <button class="tab" data-dashcut="1-15">1st Cut (1–15)</button>
          <button class="tab" data-dashcut="16-31">2nd Cut (16–31)</button>
        </div>
        <span id="dash-filter-label"></span>
      </div>

      <div class="page-body">

        <!-- Hero KPIs -->
        <div class="hero-row">
          <div class="hero-card hc-total">
            <div class="hc-label">📊 Total Bills</div>
            <div class="hc-value" id="c-total-amt">₱0.00</div>
            <div class="hc-sub"><strong id="c-total">0</strong> bills recorded</div>
          </div>
          <div class="hero-card hc-paid">
            <div class="hc-label">✅ Total Paid</div>
            <div class="hc-value" id="c-paid-amt">₱0.00</div>
            <div class="hc-sub"><strong id="c-paid">0</strong> bills paid &nbsp;·&nbsp; <strong
                id="c-paid-pct">0%</strong> of total</div>
            <div class="hc-bar-wrap">
              <div class="hc-bar" id="c-paid-bar" style="width:0%"></div>
            </div>
          </div>
          <div class="hero-card hc-remain">
            <div class="hc-label">⏳ Remaining to Pay</div>
            <div class="hc-value" id="c-remain-amt">₱0.00</div>
            <div class="hc-sub"><strong id="c-remain">0</strong> bills unpaid or overdue</div>
          </div>
        </div>

        <!-- Progress strip -->
        <div class="progress-strip">
          <span class="ps-label">💰 Overall Payment Progress</span>
          <div class="ps-bar-wrap">
            <div class="ps-bar" id="ps-bar" style="width:0%"></div>
          </div>
          <span class="ps-pct" id="ps-pct">0%</span>
          <span class="ps-text" id="ps-text">Loading…</span>
        </div>

        <!-- Stat cards -->
        <div class="stat-row">
          <div class="stat-card sc-overdue">
            <div class="sc-icon">🚨</div>
            <div class="sc-info">
              <div class="sc-label">Overdue</div>
              <div class="sc-value" id="c-overdue">0</div>
              <div class="sc-sub" id="c-overdue-amt">₱0.00</div>
            </div>
            <span class="sc-badge" id="c-overdue-badge" style="display:none">PAST DUE</span>
          </div>
          <div class="stat-card sc-week">
            <div class="sc-icon">⚠️</div>
            <div class="sc-info">
              <div class="sc-label">Due This Week</div>
              <div class="sc-value" id="c-week">0</div>
              <div class="sc-sub" id="c-week-amt">₱0.00</div>
            </div>
            <span class="sc-badge" id="c-week-badge" style="display:none">URGENT</span>
          </div>
          <div class="stat-card sc-today">
            <div class="sc-icon">⏰</div>
            <div class="sc-info">
              <div class="sc-label">Due Today</div>
              <div class="sc-value" id="c-today">0</div>
              <div class="sc-sub" id="c-today-amt">₱0.00</div>
            </div>
            <span class="sc-badge" id="c-today-badge" style="display:none">TODAY!</span>
          </div>
          <div class="stat-card sc-month">
            <div class="sc-icon">📅</div>
            <div class="sc-info">
              <div class="sc-label">This Month</div>
              <div class="sc-value" id="c-month">0</div>
              <div class="sc-sub" id="c-month-amt">₱0.00</div>
            </div>
            <span class="sc-badge sc-badge" style="background:#dbeafe;color:#1e40af" id="c-month-label">THIS
              MONTH</span>
          </div>
        </div>

        <!-- Alert strips -->
        <div class="alert-strip a-danger" id="alert-overdue">
          <div class="alert-icon">🚨</div>
          <div class="alert-body">
            <div class="alert-title">OVERDUE BILLS — Immediate attention required!</div>
            <div class="alert-pills" id="alert-overdue-list"></div>
          </div>
        </div>
        <div class="alert-strip a-warn" id="alert-soon">
          <div class="alert-icon">⚠️</div>
          <div class="alert-body">
            <div class="alert-title">DUE WITHIN 3 DAYS — Pay soon to avoid late charges</div>
            <div class="alert-pills" id="alert-soon-list"></div>
          </div>
        </div>

        <!-- Spending Charts -->
        <div class="charts-row" id="charts-row">
          <div class="chart-card">
            <h3>📊 Spending by Category</h3>
            <div class="chart-canvas-wrap"><canvas id="chart-category"></canvas></div>
          </div>
          <div class="chart-card">
            <div style="display:flex;align-items:center;justify-content:space-between">
              <h3>📈 Monthly Trend</h3>
              <span id="budget-settings-link" style="font-size:11px;color:var(--primary);cursor:pointer;font-weight:700"
                onclick="openBudgetSettings()">⚙️ Budget Limits</span>
            </div>
            <div class="chart-canvas-wrap"><canvas id="chart-monthly"></canvas></div>
            <div class="budget-row" id="budget-bars"></div>
          </div>
        </div>

        <!-- Upcoming + Recent -->
        <div class="bottom-row">
          <div class="mini-panel">
            <div class="mini-panel-head">⏳ Upcoming Bills <span class="mp-sub">Next due dates</span></div>
            <div class="mini-panel-body" id="upcoming-list">
              <div class="mini-empty">No upcoming bills</div>
            </div>
          </div>
          <div class="mini-panel">
            <div class="mini-panel-head">✅ Recent Payments <span class="mp-sub">Last paid</span></div>
            <div class="mini-panel-body" id="recent-list">
              <div class="mini-empty">No payments yet</div>
            </div>
          </div>
        </div>

      </div>
    </div><!-- /dashboard -->

    <!-- ════ BILLS PAGE ════ -->
    <div id="page-bills" class="page">
      <div class="bills-body">

        <!-- Filter bar -->
        <div class="bills-filters">
          <div class="tabs">
            <button class="tab active" data-filter="all">All</button>
            <button class="tab" data-filter="Unpaid">Unpaid</button>
            <button class="tab" data-filter="Paid">Paid</button>
            <button class="tab" data-filter="Overdue">🚨 Overdue</button>
          </div>
          <div class="f-spacer"></div>
          <select class="filter-select" id="filter-month">
            <option value="">📅 All Months</option>
          </select>
          <select class="filter-select" id="filter-cutoff">
            <option value="">✂️ All Cuts</option>
            <option value="1-15">1st Cut (1–15)</option>
            <option value="16-31">2nd Cut (16–31)</option>
          </select>
          <select class="filter-select" id="filter-category">
            <option value="">All Categories</option>
            <option>Utilities</option>
            <option>Rent</option>
            <option>Internet</option>
            <option>Phone</option>
            <option>Insurance</option>
            <option>Supplies</option>
            <option>Salary</option>
            <option>Government</option>
            <option>Others</option>
          </select>
          <div class="search-wrap">
            <span class="si">🔍</span>
            <input type="text" id="filter-search" placeholder="Search bills…" />
          </div>
          <div class="view-toggle">
            <button class="view-btn active" id="btn-list-view" title="List view" onclick="setView('list')">☰
              List</button>
            <button class="view-btn" id="btn-cal-view" title="Calendar view" onclick="setView('calendar')">📅
              Cal</button>
          </div>
          <button class="export-btn" onclick="window.print()" title="Export to PDF">🖨️ <span
              class="btn-text">Print</span></button>
          <span id="row-count"></span>
        </div>

        <!-- Calendar view -->
        <div class="cal-wrap" id="cal-view" style="display:none">
          <div class="cal-nav">
            <button class="budget-btn" onclick="calPrev()">‹</button>
            <h3 id="cal-month-label"></h3>
            <button class="budget-btn" onclick="calNext()">›</button>
          </div>
          <div class="cal-header">
            <div class="cal-dow">Sun</div>
            <div class="cal-dow">Mon</div>
            <div class="cal-dow">Tue</div>
            <div class="cal-dow">Wed</div>
            <div class="cal-dow">Thu</div>
            <div class="cal-dow">Fri</div>
            <div class="cal-dow">Sat</div>
          </div>
          <div class="cal-grid" id="cal-grid"></div>
        </div>

        <!-- Table -->
        <div class="table-scroll" id="list-view">
          <div class="empty-state" id="empty-msg">
            <div class="ei">📄</div>
            <h3>Loading bills…</h3>
            <p>Please wait</p>
          </div>
          <table id="bills-table" style="display:none">
            <thead>
              <tr>
                <th onclick="sortBy('Bill Name')">Bill Name</th>
                <th class="no-sort th-group-col" style="display:none">Group</th>
                <th onclick="sortBy('Category')">Category</th>
                <th onclick="sortBy('Amount')">Amount</th>
                <th onclick="sortBy('Due Date')">Due / Cut-off Date</th>
                <th class="no-sort">Status</th>
                <th onclick="sortBy('Payment Date')">Date Paid</th>
                <th class="no-sort">Notes</th>
                <th class="no-sort">Proof</th>
                <th class="no-sort">Actions</th>
              </tr>
            </thead>
            <tbody id="bills-body"></tbody>
          </table>
        </div>

      </div>
    </div><!-- /bills -->

    <!-- ════ LOANS PAGE ════ -->
    <div id="page-loans" class="page">
      <div class="bills-body">

        <!-- KPI section -->
        <div class="loans-kpi">
          <div class="hero-row">
            <div class="hero-card hc-total">
              <div class="hc-label">💰 Total Borrowed</div>
              <div class="hc-value" id="l-total-amt">₱0.00</div>
              <div class="hc-sub"><strong id="l-total-count">0</strong> loans</div>
            </div>
            <div class="hero-card hc-paid">
              <div class="hc-label">✅ Total Paid</div>
              <div class="hc-value" id="l-paid-amt">₱0.00</div>
              <div class="hc-sub"><strong id="l-progress-pct">0%</strong> of total</div>
              <div class="hc-bar-wrap">
                <div class="hc-bar" id="l-progress-bar" style="width:0%"></div>
              </div>
            </div>
            <div class="hero-card hc-remain">
              <div class="hc-label">⏳ Outstanding</div>
              <div class="hc-value" id="l-outstanding-amt">₱0.00</div>
              <div class="hc-sub"><strong id="l-overdue-count" style="color:var(--danger)">0</strong> overdue</div>
            </div>
          </div>
        </div>

        <!-- Filter bar -->
        <div class="bills-filters">
          <div class="tabs" id="loan-tabs">
            <button class="tab active" data-loan-filter="all">All</button>
            <button class="tab" data-loan-filter="Active">Active</button>
            <button class="tab" data-loan-filter="Overdue">🚨 Overdue</button>
            <button class="tab" data-loan-filter="Paid Off">✅ Paid</button>
          </div>
          <div class="f-spacer"></div>
          <div class="search-wrap">
            <span class="si">🔍</span>
            <input type="text" id="loan-search" placeholder="Search loans…" />
          </div>
          <span id="loan-row-count"></span>
          <button id="btn-add-loan"
            style="display:flex;align-items:center;gap:6px;padding:8px 16px;background:var(--primary);color:#fff;border:none;border-radius:8px;cursor:pointer;font-size:13px;font-weight:600;font-family:inherit;white-space:nowrap">＋
            <span class="btn-text">Add Loan</span></button>
        </div>

        <!-- Table -->
        <div class="table-scroll">
          <div class="empty-state" id="loans-empty">
            <div class="ei">💳</div>
            <h3>No loans yet</h3>
            <p>Click "＋ Add Loan" to start tracking</p>
          </div>
          <table id="loans-table" style="display:none">
            <thead>
              <tr>
                <th>Loan Name</th>
                <th class="no-sort th-group-col" style="display:none">Group</th>
                <th>Lender / From</th>
                <th>Principal</th>
                <th>Monthly Due</th>
                <th style="min-width:140px">Paid / Progress</th>
                <th>Remaining</th>
                <th class="no-sort">Status</th>
                <th class="no-sort">Actions</th>
              </tr>
            </thead>
            <tbody id="loans-body"></tbody>
          </table>
        </div>

      </div>
    </div><!-- /loans -->

    <!-- ════ USERS PAGE (admin only) ════ -->
    <div id="page-users" class="page">
      <div class="bills-body">
        <div class="bills-filters">
          <div class="tabs" id="users-tabs">
            <button class="tab active" data-user-filter="all">All</button>
            <button class="tab" data-user-filter="Pending">⏳ Pending</button>
            <button class="tab" data-user-filter="Active">✅ Active</button>
            <button class="tab" data-user-filter="Rejected">🚫 Rejected</button>
          </div>
          <div class="f-spacer"></div>
          <span id="users-count" style="font-size:12px;color:var(--muted)"></span>
          <button onclick="loadUsers()"
            style="padding:7px 14px;border:1px solid var(--border);background:var(--card);border-radius:8px;cursor:pointer;font-size:12px;font-weight:600;color:var(--text);font-family:inherit">🔄
            Refresh</button>
        </div>
        <div class="table-scroll">
          <div class="empty-state" id="users-empty" style="display:none">
            <div class="ei">👥</div>
            <h3>No users found</h3>
            <p>Adjust your filter</p>
          </div>
          <table id="users-table" style="display:none">
            <thead>
              <tr>
                <th class="no-sort">#</th>
                <th class="no-sort">Username</th>
                <th class="no-sort">Group</th>
                <th class="no-sort">Status</th>
                <th class="no-sort">Registered</th>
                <th class="no-sort">Actions</th>
              </tr>
            </thead>
            <tbody id="users-body"></tbody>
          </table>
        </div>
      </div>
    </div><!-- /users -->

    <!-- ════ GROUPS PAGE (admin only) ════ -->
    <div id="page-groups" class="page">
      <div class="bills-body">
        <div class="bills-filters">
          <div style="font-size:13px;color:var(--muted)">Manage household groups. Users select a group when registering.
          </div>
          <div class="f-spacer"></div>
          <span id="groups-count" style="font-size:12px;color:var(--muted)"></span>
          <button onclick="loadGroups()"
            style="padding:7px 14px;border:1px solid var(--border);background:var(--card);border-radius:8px;cursor:pointer;font-size:12px;font-weight:600;color:var(--text);font-family:inherit">🔄
            Refresh</button>
          <button id="btn-add-group" onclick="openGroupModal()"
            style="padding:7px 16px;background:var(--primary);color:#fff;border:none;border-radius:8px;cursor:pointer;font-size:12px;font-weight:700;font-family:inherit">+
            Add Group</button>
        </div>
        <div class="table-scroll">
          <div class="empty-state" id="groups-empty" style="display:none">
            <div class="ei">🏠</div>
            <h3>No groups yet</h3>
            <p>Add a group so users can register</p>
          </div>
          <table id="groups-table" style="display:none">
            <thead>
              <tr>
                <th class="no-sort">#</th>
                <th class="no-sort">Group Name</th>
                <th class="no-sort">Code</th>
                <th class="no-sort">Description</th>
                <th class="no-sort">Members</th>
                <th class="no-sort">Created</th>
                <th class="no-sort">Actions</th>
              </tr>
            </thead>
            <tbody id="groups-body"></tbody>
          </table>
        </div>
      </div>
    </div><!-- /groups -->

  </div><!-- /content -->

  <!-- ════ ADD GROUP MODAL ════ -->
  <div class="overlay" id="group-modal-overlay">
    <div class="modal" style="max-width:440px">
      <div class="modal-drag"></div>
      <h2 id="group-modal-title">Add Group</h2>
      <div class="form-grid">
        <div class="field full"><label>Group Name *</label><input type="text" id="gf-name"
            placeholder="e.g. Neo Household" oninput="autoGroupCode(this.value)" /></div>
        <div class="field full">
          <label>Group Code <span style="font-size:11px;color:var(--muted)">(auto-generated — edit only if
              needed)</span></label>
          <div style="position:relative">
            <input type="text" id="gf-code" placeholder="auto" style="padding-right:70px" />
            <span id="gf-code-lock"
              style="position:absolute;right:10px;top:50%;transform:translateY(-50%);font-size:11px;color:var(--muted);pointer-events:none">auto
              ✨</span>
          </div>
        </div>
        <div class="field full"><label>Description</label><input type="text" id="gf-desc"
            placeholder="Optional description…" /></div>
      </div>
      <div class="modal-footer">
        <button class="btn-secondary" onclick="closeGroupModal()">Cancel</button>
        <button class="btn-primary" id="btn-group-save" onclick="saveGroup()">Save Group</button>
      </div>
    </div>
  </div>

  <!-- ════ CHANGE OWN PASSWORD MODAL ════ -->
  <div class="overlay" id="changepw-overlay">
    <div class="modal" style="max-width:400px">
      <div class="modal-drag"></div>
      <h2>🔒 Change Password</h2>
      <div id="changepw-alert"
        style="display:none;border-radius:9px;padding:10px 14px;font-size:13px;font-weight:500;margin-bottom:14px;align-items:center;gap:8px">
      </div>
      <div class="form-grid">
        <div class="field full"><label>Current Password</label><input type="password" id="cpw-current"
            placeholder="Enter current password" /></div>
        <div class="field full"><label>New Password</label><input type="password" id="cpw-new"
            placeholder="At least 6 characters" /></div>
        <div class="field full"><label>Confirm New Password</label><input type="password" id="cpw-confirm"
            placeholder="Re-enter new password" /></div>
      </div>
      <div class="modal-footer">
        <button class="btn-secondary" onclick="closeChangePw()">Cancel</button>
        <button class="btn-primary" id="btn-changepw-save" onclick="saveChangePw()">Update Password</button>
      </div>
    </div>
  </div>

  <!-- ════ RESET USER PASSWORD MODAL (admin) ════ -->
  <div class="overlay" id="resetpw-overlay">
    <div class="modal" style="max-width:400px">
      <div class="modal-drag"></div>
      <h2>🔑 Reset Password</h2>
      <p id="resetpw-sub" style="font-size:13px;color:var(--muted);margin-bottom:18px"></p>
      <div id="resetpw-alert"
        style="display:none;border-radius:9px;padding:10px 14px;font-size:13px;font-weight:500;margin-bottom:14px;align-items:center;gap:8px">
      </div>
      <div class="form-grid">
        <div class="field full"><label>New Password</label><input type="password" id="rpw-new"
            placeholder="At least 6 characters" /></div>
        <div class="field full"><label>Confirm Password</label><input type="password" id="rpw-confirm"
            placeholder="Re-enter new password" /></div>
      </div>
      <div class="modal-footer">
        <button class="btn-secondary" onclick="closeResetPw()">Cancel</button>
        <button class="btn-primary" id="btn-resetpw-save" onclick="saveResetPw()">Reset Password</button>
      </div>
    </div>
  </div>

  <!-- ════ HELP / GUIDE MODAL ════ -->
  <div class="help-overlay" id="help-overlay" onclick="if(event.target===this)closeHelp()">
    <div class="help-modal">

      <div class="help-header">
        <div>
          <h2>📖 How to Use Expense Monitor</h2>
          <p>Step-by-step guide from login to managing transactions</p>
        </div>
        <button class="help-close" onclick="closeHelp()">✕</button>
      </div>

      <!-- Step tabs -->
      <div class="help-steps-nav" id="help-tabs"></div>

      <!-- Slides -->
      <div class="help-body">

        <!-- Step 1: Login -->
        <div class="help-slide active" data-step="0">
          <div class="help-slide-header">
            <div class="help-step-icon">🔐</div>
            <div>
              <h3>Step 1 — Sign In</h3>
              <p>Open the app at <strong>http://localhost:3000</strong> and sign in with your username and password.
                First-time default: <code
                  style="background:var(--bg);padding:1px 5px;border-radius:4px">admin / admin123</code></p>
            </div>
          </div>
          <div class="help-mockup">
            <div class="mock-bar">
              <div class="mock-dot" style="background:#ff5f57"></div>
              <div class="mock-dot" style="background:#febc2e"></div>
              <div class="mock-dot" style="background:#28c840"></div>
              <span style="font-size:10px;color:rgba(255,255,255,.5);margin-left:8px">localhost:3000/login</span>
            </div>
            <div class="mock-body" style="display:flex;gap:0;padding:0">
              <div
                style="flex:0 0 200px;background:linear-gradient(160deg,#3730a3,#4c1d95);padding:20px 16px;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center">
                <div
                  style="background:#fff;border-radius:10px;padding:6px 10px;margin-bottom:10px;display:inline-block">
                  <span style="font-size:22px">💰</span>
                </div>
                <div style="font-size:13px;font-weight:800;color:#fff">Expense Monitor</div>
                <div style="font-size:10px;color:rgba(255,255,255,.5);margin-top:4px">Track your bills &amp; loans</div>
              </div>
              <div style="flex:1;background:#fff;padding:18px 16px">
                <div style="font-size:13px;font-weight:800;color:#1e293b;margin-bottom:12px">Welcome back 👋</div>
                <div
                  style="background:#f8fafc;border:1.5px solid #e2e8f0;border-radius:8px;padding:8px 10px;font-size:11px;color:#94a3b8;margin-bottom:6px">
                  👤 Username</div>
                <div
                  style="background:#f8fafc;border:1.5px solid #e2e8f0;border-radius:8px;padding:8px 10px;font-size:11px;color:#94a3b8;margin-bottom:10px">
                  🔑 Password</div>
                <div
                  style="background:linear-gradient(135deg,#6366f1,#4f46e5);border-radius:8px;padding:9px;text-align:center;font-size:11px;font-weight:700;color:#fff">
                  Sign In</div>
              </div>
            </div>
          </div>
          <div class="help-tips">
            <p>💡 Tips</p>
            <ul>
              <li>Default admin password is <strong>admin123</strong> — change it after first login</li>
              <li>If your account shows "Pending", wait for the admin to approve it</li>
              <li>Forgot password? Ask the admin to reset it from the Users page</li>
            </ul>
          </div>
        </div>

        <!-- Step 2: Register -->
        <div class="help-slide" data-step="1">
          <div class="help-slide-header">
            <div class="help-step-icon">📝</div>
            <div>
              <h3>Step 2 — Create an Account</h3>
              <p>New members click <strong>"Create Account"</strong> on the login page. Fill in username, choose your
                household group, set a password, and submit. Your account waits for admin approval.</p>
            </div>
          </div>
          <div class="help-mockup">
            <div class="mock-bar">
              <div class="mock-dot" style="background:#ff5f57"></div>
              <div class="mock-dot" style="background:#febc2e"></div>
              <div class="mock-dot" style="background:#28c840"></div>
              <span style="font-size:10px;color:rgba(255,255,255,.5);margin-left:8px">localhost:3000/register</span>
            </div>
            <div class="mock-body" style="display:flex;gap:0;padding:0">
              <div
                style="flex:0 0 160px;background:linear-gradient(160deg,#3730a3,#4c1d95);padding:16px 12px;display:flex;flex-direction:column;align-items:center;justify-content:center">
                <div style="background:#fff;border-radius:10px;padding:5px 8px;margin-bottom:8px;display:inline-block">
                  <span style="font-size:18px">💰</span>
                </div>
                <div style="font-size:11px;font-weight:800;color:#fff;text-align:center">Join Expense Monitor</div>
                <div style="margin-top:10px;text-align:left;width:100%">
                  <div style="font-size:9px;color:rgba(255,255,255,.5);padding:3px 0 3px 12px;position:relative">①<span
                      style="position:absolute;left:0">→</span> Choose group</div>
                  <div style="font-size:9px;color:rgba(255,255,255,.5);padding:3px 0 3px 12px">② Set password</div>
                  <div style="font-size:9px;color:rgba(255,255,255,.5);padding:3px 0 3px 12px">③ Wait approval</div>
                </div>
              </div>
              <div style="flex:1;background:#fff;padding:16px 14px">
                <div style="font-size:12px;font-weight:800;color:#1e293b;margin-bottom:10px">Create Account ✨</div>
                <div style="display:grid;grid-template-columns:1fr 1fr;gap:6px;margin-bottom:6px">
                  <div
                    style="background:#f8fafc;border:1.5px solid #e2e8f0;border-radius:6px;padding:6px 8px;font-size:10px;color:#94a3b8">
                    👤 Username</div>
                  <div
                    style="background:#f8fafc;border:1.5px solid #6366f1;border-radius:6px;padding:6px 8px;font-size:10px;color:#6366f1">
                    🏠 Neo &amp; Nova ▼</div>
                </div>
                <div style="display:grid;grid-template-columns:1fr 1fr;gap:6px;margin-bottom:10px">
                  <div
                    style="background:#f8fafc;border:1.5px solid #e2e8f0;border-radius:6px;padding:6px 8px;font-size:10px;color:#94a3b8">
                    🔑 Password</div>
                  <div
                    style="background:#f8fafc;border:1.5px solid #e2e8f0;border-radius:6px;padding:6px 8px;font-size:10px;color:#94a3b8">
                    🔒 Confirm</div>
                </div>
                <div
                  style="background:linear-gradient(135deg,#6366f1,#4f46e5);border-radius:7px;padding:7px;text-align:center;font-size:10px;font-weight:700;color:#fff">
                  Create Account</div>
              </div>
            </div>
          </div>
          <div class="help-tips">
            <p>💡 Tips</p>
            <ul>
              <li>Username: 3–20 characters, letters/numbers/underscore only</li>
              <li>Password must be at least 6 characters</li>
              <li>Select the correct household group — this determines which bills you see</li>
            </ul>
          </div>
        </div>

        <!-- Step 3: Dashboard -->
        <div class="help-slide" data-step="2">
          <div class="help-slide-header">
            <div class="help-step-icon">📊</div>
            <div>
              <h3>Step 3 — Dashboard Overview</h3>
              <p>After login you see the <strong>Dashboard</strong> — summary cards showing total bills, unpaid amount,
                overdue count, and charts. Use the cut-off filter to view 1st or 2nd half of the month.</p>
            </div>
          </div>
          <div class="help-mockup">
            <div class="mock-bar">
              <div class="mock-dot" style="background:#ff5f57"></div>
              <div class="mock-dot" style="background:#febc2e"></div>
              <div class="mock-dot" style="background:#28c840"></div>
            </div>
            <div class="mock-body" style="display:flex;gap:0;padding:0">
              <div style="width:90px;background:linear-gradient(180deg,#1e1b4b,#312e81);padding:10px 8px">
                <div style="font-size:9px;font-weight:800;color:#fff;margin-bottom:10px;text-align:center">Expense
                  Monitor</div>
                <div
                  style="background:rgba(255,255,255,.18);border-radius:6px;padding:5px 6px;font-size:9px;color:#fff;margin-bottom:3px">
                  📊 Dashboard</div>
                <div
                  style="border-radius:6px;padding:5px 6px;font-size:9px;color:rgba(255,255,255,.6);margin-bottom:3px">
                  📋 Bills</div>
                <div
                  style="border-radius:6px;padding:5px 6px;font-size:9px;color:rgba(255,255,255,.6);margin-bottom:3px">
                  💳 Loans</div>
              </div>
              <div style="flex:1;background:#f1f5f9;padding:10px">
                <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:6px;margin-bottom:8px">
                  <div style="background:#fff;border-radius:8px;padding:8px;border:1px solid #e2e8f0">
                    <div style="font-size:9px;color:#94a3b8">Total Bills</div>
                    <div style="font-size:13px;font-weight:800;color:#1e293b">₱12,500</div>
                  </div>
                  <div style="background:#fff;border-radius:8px;padding:8px;border:1px solid #e2e8f0">
                    <div style="font-size:9px;color:#94a3b8">Unpaid</div>
                    <div style="font-size:13px;font-weight:800;color:#f59e0b">₱4,200</div>
                  </div>
                  <div style="background:#fff;border-radius:8px;padding:8px;border:1px solid #e2e8f0">
                    <div style="font-size:9px;color:#94a3b8">Overdue</div>
                    <div style="font-size:13px;font-weight:800;color:#ef4444">2</div>
                  </div>
                </div>
                <div
                  style="background:#fff;border-radius:8px;border:1px solid #e2e8f0;padding:8px;height:50px;display:flex;align-items:center;justify-content:center;color:#94a3b8;font-size:10px">
                  📈 Spending Chart</div>
              </div>
            </div>
          </div>
          <div class="help-tips">
            <p>💡 Tips</p>
            <ul>
              <li>Use <strong>1st Cut (1–15)</strong> / <strong>2nd Cut (16–31)</strong> to filter by cut-off period
              </li>
              <li>Red numbers = overdue bills that need attention</li>
              <li>Dark mode toggle is at the top-right (🌙)</li>
            </ul>
          </div>
        </div>

        <!-- Step 4: Bills -->
        <div class="help-slide" data-step="3">
          <div class="help-slide-header">
            <div class="help-step-icon">📋</div>
            <div>
              <h3>Step 4 — Managing Bills</h3>
              <p>Go to <strong>Bills</strong> from the sidebar. Add a bill with the <strong>＋ Add Bill</strong> button.
                Mark bills as Paid using the ✓ button. Upload proof of payment with 📎.</p>
            </div>
          </div>
          <div class="help-mockup">
            <div class="mock-bar">
              <div class="mock-dot" style="background:#ff5f57"></div>
              <div class="mock-dot" style="background:#febc2e"></div>
              <div class="mock-dot" style="background:#28c840"></div>
            </div>
            <div class="mock-body" style="padding:10px">
              <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:8px">
                <div style="display:flex;gap:4px">
                  <span
                    style="background:#6366f1;color:#fff;padding:3px 9px;border-radius:99px;font-size:9px;font-weight:700">All</span>
                  <span
                    style="background:#f1f5f9;color:#94a3b8;padding:3px 9px;border-radius:99px;font-size:9px">Unpaid</span>
                  <span
                    style="background:#f1f5f9;color:#94a3b8;padding:3px 9px;border-radius:99px;font-size:9px">Paid</span>
                </div>
                <div
                  style="background:linear-gradient(135deg,#6366f1,#4f46e5);color:#fff;padding:4px 10px;border-radius:6px;font-size:9px;font-weight:700">
                  ＋ Add Bill</div>
              </div>
              <div class="mock-row"><span>⚡ Meralco — Oct</span><span
                  class="mock-badge mock-tag-over">Overdue</span><span
                  style="margin-left:auto;font-weight:700;color:#ef4444">₱2,500</span></div>
              <div class="mock-row"><span>🌐 Internet — Oct</span><span
                  class="mock-badge mock-tag-unpaid">Unpaid</span><span
                  style="margin-left:auto;font-weight:700;color:#f59e0b">₱1,299</span></div>
              <div class="mock-row"><span>🏠 Rent — Oct</span><span class="mock-badge mock-tag-paid">Paid</span><span
                  style="margin-left:auto;font-weight:700;color:#22c55e">₱8,000</span></div>
            </div>
          </div>
          <div class="help-tips">
            <p>💡 Tips</p>
            <ul>
              <li>Click <strong>✓</strong> on a row to quickly mark a bill as Paid</li>
              <li>Click <strong>📎</strong> to upload a photo of the receipt as proof</li>
              <li>Set <strong>Recurrence</strong> (monthly, weekly) and bills auto-copy each period</li>
              <li>Switch to 📅 Calendar view to see bills on a calendar</li>
            </ul>
          </div>
        </div>

        <!-- Step 5: Loans -->
        <div class="help-slide" data-step="4">
          <div class="help-slide-header">
            <div class="help-step-icon">💳</div>
            <div>
              <h3>Step 5 — Loan Tracker</h3>
              <p>Go to <strong>Loans</strong> to track borrowed money. Add a loan with lender, principal, and monthly
                payment. Click <strong>💳 Pay</strong> to record each payment and watch the progress bar fill up.</p>
            </div>
          </div>
          <div class="help-mockup">
            <div class="mock-bar">
              <div class="mock-dot" style="background:#ff5f57"></div>
              <div class="mock-dot" style="background:#febc2e"></div>
              <div class="mock-dot" style="background:#28c840"></div>
            </div>
            <div class="mock-body" style="padding:10px">
              <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:6px;margin-bottom:8px">
                <div style="background:#f0fdf4;border:1px solid #bbf7d0;border-radius:8px;padding:8px">
                  <div style="font-size:9px;color:#166534">Total Borrowed</div>
                  <div style="font-size:12px;font-weight:800;color:#166534">₱50,000</div>
                </div>
                <div style="background:#eff6ff;border:1px solid #bfdbfe;border-radius:8px;padding:8px">
                  <div style="font-size:9px;color:#1d4ed8">Total Paid</div>
                  <div style="font-size:12px;font-weight:800;color:#1d4ed8">₱20,000</div>
                </div>
                <div style="background:#fefce8;border:1px solid #fde68a;border-radius:8px;padding:8px">
                  <div style="font-size:9px;color:#854d0e">Outstanding</div>
                  <div style="font-size:12px;font-weight:800;color:#854d0e">₱30,000</div>
                </div>
              </div>
              <div class="mock-row" style="flex-direction:column;align-items:flex-start;gap:4px">
                <div style="display:flex;width:100%;align-items:center;justify-content:space-between">
                  <span style="font-weight:700;font-size:11px">SSS Salary Loan</span>
                  <span class="mock-badge mock-tag-unpaid">Active</span>
                </div>
                <div style="width:100%;background:#e2e8f0;border-radius:99px;height:5px">
                  <div style="width:40%;height:100%;background:#6366f1;border-radius:99px"></div>
                </div>
                <div style="font-size:9px;color:#94a3b8">₱20,000 paid · 40% · ₱30,000 remaining</div>
              </div>
            </div>
          </div>
          <div class="help-tips">
            <p>💡 Tips</p>
            <ul>
              <li>Click <strong>💳 Pay</strong> to log a payment — it updates the progress bar automatically</li>
              <li>Set <strong>Due Day</strong> so overdue loans are flagged in red</li>
              <li>Loan is marked <strong>Paid Off</strong> automatically when payments reach the principal</li>
            </ul>
          </div>
        </div>

      </div><!-- /help-body -->

      <div class="help-footer">
        <span class="help-counter" id="help-counter">Step 1 of 5</span>
        <div class="help-nav-btns">
          <button class="help-nav-btn" id="btn-help-prev" onclick="helpNav(-1)">← Previous</button>
          <button class="help-nav-btn primary" id="btn-help-next" onclick="helpNav(1)">Next →</button>
        </div>
      </div>

    </div>
  </div>

  <!-- ════ APPROVE USER CONFIRMATION MODAL ════ -->
  <div class="overlay" id="approveconfirm-overlay">
    <div class="modal" style="max-width:420px">
      <div class="modal-drag"></div>
      <h2>✅ Approve User</h2>
      <p id="approveconfirm-sub" style="font-size:13px;color:var(--muted);margin-bottom:18px"></p>

      <div id="approveconfirm-alert"
        style="display:none;background:#fef3c7;border:1px solid #fde68a;color:#92400e;border-radius:9px;padding:10px 14px;font-size:13px;margin-bottom:14px">
      </div>

      <label class="modal-label">Household Group</label>
      <p style="font-size:12px;color:var(--muted);margin-bottom:8px">
        This member selected the group below when registering. Confirm it is correct or change it before approving.
      </p>
      <div class="input-wrap" style="margin-bottom:20px">
        <span class="input-icon">🏠</span>
        <select id="approveconfirm-group" class="modal-input" style="padding-left:34px">
          <option value="">Loading…</option>
        </select>
      </div>

      <div style="display:flex;gap:10px">
        <button class="btn-sec" style="flex:1"
          onclick="document.getElementById('approveconfirm-overlay').classList.remove('open')">Cancel</button>
        <button class="btn-primary" style="flex:2;background:linear-gradient(135deg,#22c55e,#16a34a)"
          id="btn-approveconfirm-save" onclick="saveApproveConfirm()">✅ Confirm &amp; Approve</button>
      </div>
    </div>
  </div>

  <!-- ════ CHANGE USER GROUP MODAL (admin) ════ -->
  <div class="overlay" id="changegroup-overlay">
    <div class="modal" style="max-width:400px">
      <div class="modal-drag"></div>
      <h2>🏠 Change Group</h2>
      <p id="changegroup-sub" style="font-size:13px;color:var(--muted);margin-bottom:18px"></p>
      <div id="changegroup-alert"
        style="display:none;border-radius:9px;padding:10px 14px;font-size:13px;font-weight:500;margin-bottom:14px;align-items:center;gap:8px">
      </div>
      <div class="form-grid">
        <div class="field full">
          <label>Assign to Group</label>
          <div style="position:relative">
            <span
              style="position:absolute;left:12px;top:50%;transform:translateY(-50%);font-size:15px;pointer-events:none">🏠</span>
            <select id="cg-group"
              style="width:100%;padding:11px 13px 11px 38px;border:1.5px solid var(--border);border-radius:10px;font-size:14px;font-family:inherit;color:var(--text);outline:none;background:var(--card);appearance:none;cursor:pointer">
            </select>
            <span
              style="position:absolute;right:12px;top:50%;transform:translateY(-50%);pointer-events:none;color:var(--muted);font-size:12px">▼</span>
          </div>
        </div>
      </div>
      <div class="modal-footer">
        <button class="btn-secondary" onclick="closeChangeGroup()">Cancel</button>
        <button class="btn-primary" id="btn-changegroup-save" onclick="saveChangeGroup()">Save</button>
      </div>
    </div>
  </div>

  <!-- ════ ADD / EDIT MODAL ════ -->
  <div class="overlay" id="modal-overlay">
    <div class="modal">
      <div class="modal-drag"></div>
      <h2 id="modal-title">Add New Bill</h2>
      <div class="form-grid">
        <div class="field full"><label>Bill Name *</label><input type="text" id="f-name"
            placeholder="e.g. Meralco — October 2025" /></div>
        <div class="field"><label>Category</label>
          <select id="f-category">
            <option>Utilities</option>
            <option>Rent</option>
            <option>Internet</option>
            <option>Phone</option>
            <option>Insurance</option>
            <option>Supplies</option>
            <option>Salary</option>
            <option>Government</option>
            <option>Others</option>
          </select>
        </div>
        <div class="field"><label>Amount (₱) *</label><input type="number" id="f-amount" placeholder="0.00" min="0"
            step="0.01" /></div>
        <div class="field"><label>Due / Cut-off Date *</label><input type="date" id="f-due" /></div>
        <div class="field"><label>Status</label>
          <select id="f-status">
            <option>Unpaid</option>
            <option>Paid</option>
          </select>
        </div>
        <div class="field"><label>Date Paid</label><input type="date" id="f-paydate" /></div>
        <div class="field">
          <label>Recurrence</label>
          <select id="f-recurrence">
            <option value="">None (one-time)</option>
            <option value="weekly">Weekly</option>
            <option value="monthly">Monthly</option>
            <option value="bimonthly">Every 2 months</option>
            <option value="yearly">Yearly</option>
          </select>
        </div>
        <div class="field full"><label>Notes</label><input type="text" id="f-notes" placeholder="Optional remarks…" />
        </div>
      </div>
      <div class="modal-footer">
        <button class="btn-secondary" id="btn-modal-cancel">Cancel</button>
        <button class="btn-primary" id="btn-modal-save">Save Bill</button>
      </div>
    </div>
  </div>

  <!-- ════ ADD / EDIT LOAN MODAL ════ -->
  <div class="overlay" id="loan-modal-overlay">
    <div class="modal">
      <div class="modal-drag"></div>
      <h2 id="loan-modal-title">Add New Loan</h2>
      <div class="form-grid">
        <div class="field full"><label>Loan Name *</label><input type="text" id="lf-name"
            placeholder="e.g. BDO Personal Loan" /></div>
        <div class="field"><label>Lender / From *</label><input type="text" id="lf-lender"
            placeholder="e.g. BDO, SSS, Friend" /></div>
        <div class="field"><label>Principal Amount (₱) *</label><input type="number" id="lf-principal"
            placeholder="0.00" min="0" step="0.01" /></div>
        <div class="field"><label>Monthly Payment (₱)</label><input type="number" id="lf-monthly" placeholder="0.00"
            min="0" step="0.01" /></div>
        <div class="field"><label>Total Terms (months)</label><input type="number" id="lf-terms" placeholder="e.g. 24"
            min="1" /></div>
        <div class="field"><label>Due Day of Month</label><input type="number" id="lf-dueday" placeholder="e.g. 15"
            min="1" max="31" /></div>
        <div class="field"><label>Start Date</label><input type="date" id="lf-startdate" /></div>
        <div class="field full"><label>Notes</label><input type="text" id="lf-notes" placeholder="Optional remarks…" />
        </div>
      </div>
      <div class="modal-footer">
        <button class="btn-secondary" id="btn-loan-cancel">Cancel</button>
        <button class="btn-primary" id="btn-loan-save">Add Loan</button>
      </div>
    </div>
  </div>

  <!-- ════ LOAN PAYMENTS MODAL ════ -->
  <div class="overlay" id="loan-pmt-overlay">
    <div class="modal" style="max-width:540px">
      <div class="modal-drag"></div>
      <h2 id="pmt-loan-name">Loan Payments</h2>

      <!-- Summary bar -->
      <div style="margin-bottom:14px">
        <div
          style="display:flex;justify-content:space-between;align-items:center;margin-bottom:6px;gap:8px;flex-wrap:wrap">
          <span id="pmt-paid-label" style="font-size:13px;font-weight:700;color:var(--success)">₱0 paid</span>
          <span id="pmt-pct-label" style="font-size:12px;color:var(--muted)">0%</span>
          <span id="pmt-remaining-label" style="font-size:13px;font-weight:700;color:var(--warning)">₱0 remaining</span>
        </div>
        <div class="hc-bar-wrap">
          <div class="hc-bar" id="pmt-progress" style="width:0%"></div>
        </div>
      </div>

      <!-- Add payment inline form -->
      <div style="background:var(--bg);border-radius:var(--radius);padding:14px;margin-bottom:14px">
        <div
          style="font-size:11px;font-weight:700;color:var(--muted);text-transform:uppercase;letter-spacing:.05em;margin-bottom:10px">
          ➕ Record a Payment</div>
        <div class="form-grid" style="gap:10px">
          <div class="field">
            <label>Amount Paid (₱) *</label>
            <input type="number" id="pf-amount" placeholder="0.00" min="0" step="0.01" />
          </div>
          <div class="field">
            <label>Payment Date *</label>
            <input type="date" id="pf-date" />
          </div>
          <div class="field full">
            <label>Notes</label>
            <input type="text" id="pf-notes" placeholder="e.g. Online transfer, receipt #123…" />
          </div>
        </div>
        <button class="btn-primary" id="btn-add-payment" style="margin-top:10px;width:100%">✅ Record Payment</button>
      </div>

      <!-- Payment history list -->
      <div
        style="font-size:11px;font-weight:700;color:var(--muted);text-transform:uppercase;letter-spacing:.05em;margin-bottom:8px">
        📋 Payment History</div>
      <div class="pmt-list" id="pmt-list"></div>

      <div class="modal-footer" style="margin-top:14px">
        <button class="btn-secondary" id="btn-pmt-close" style="flex:1">Close</button>
      </div>
    </div>
  </div>


  <!-- ════ BUDGET SETTINGS MODAL ════ -->
  <div class="overlay" id="budget-modal-overlay">
    <div class="modal" style="max-width:420px">
      <div class="modal-drag"></div>
      <h2>⚙️ Budget Limits per Category</h2>
      <p style="font-size:12px;color:var(--muted);margin-bottom:14px">Set a monthly spending cap per category. Leave
        blank or 0 for no limit.</p>
      <div class="form-grid" id="budget-fields"></div>
      <div class="modal-footer">
        <button class="btn-secondary" id="btn-budget-cancel">Cancel</button>
        <button class="btn-primary" id="btn-budget-save">Save Limits</button>
      </div>
    </div>
  </div>

  <!-- ════ PROOF LIGHTBOX ════ -->
  <div id="lightbox-overlay">
    <div class="lb-toolbar">
      <span class="lb-title" id="lb-title">📎 Payment Proof</span>
      <a class="lb-btn lb-download" id="lb-download" download>⬇ Download</a>
      <button class="lb-btn lb-del" id="lb-remove">🗑 Remove</button>
      <button class="lb-btn lb-close" id="lb-close">✕ Close</button>
    </div>
    <div id="lb-body"></div>
  </div>
  <input type="file" id="att-file-input" accept="image/*,.pdf" style="display:none">

  <!-- ════ DELETE CONFIRM ════ -->
  <div id="confirm-overlay">
    <div class="confirm-box">
      <div class="ci">🗑️</div>
      <h3>Delete Bill?</h3>
      <p id="confirm-msg">This cannot be undone.</p>
      <div class="confirm-actions">
        <button class="btn-ghost" id="btn-no">Cancel</button>
        <button class="btn-danger" id="btn-yes">Delete</button>
      </div>
    </div>
  </div>

  <div id="toast"></div>

  <script>
    // ── State ─────────────────────────────────────────────────────
    let bills = [];
    let editId = null;
    let deleteId = null;
    let deleteContext = 'bill';   // 'bill' | 'loan'
    let filterStatus = 'all';
    let filterCutoff = '';
    let dashFilterMonth = '';
    let dashFilterCutoff = '';
    let attBillId = null;
    let sortKey = 'Due Date';
    let sortAsc = true;
    let activePage = 'dashboard';

    // Loans
    let loans = [];
    let loanPayments = [];
    let editLoanId = null;
    let deleteLoanId = null;
    let viewLoanId = null;
    let loanFilterStatus = 'all';

    // ── Boot ──────────────────────────────────────────────────────
    window.addEventListener('DOMContentLoaded', () => {
      const now = new Date();
      document.getElementById('top-date').textContent =
        now.toLocaleDateString('en-PH', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' });
      document.getElementById('c-month-label').textContent =
        now.toLocaleDateString('en-PH', { month: 'short', year: 'numeric' }).toUpperCase();

      // Auto-detect current cut-off period from today's date
      const day = now.getDate();
      const currentCutoff = day <= 15 ? '1-15' : '16-31';
      const currentMonth = now.toISOString().slice(0, 7); // YYYY-MM

      // Pre-select filters
      dashFilterCutoff = currentCutoff;
      dashFilterMonth = currentMonth;
      filterCutoff = currentCutoff;

      // Sync dashboard cut-off tabs
      document.querySelectorAll('[data-dashcut]').forEach(btn => {
        btn.classList.toggle('active', btn.dataset.dashcut === currentCutoff);
      });

      // Show current cut-off chip in topbar subtitle
      const cutLabel = currentCutoff === '1-15' ? '1st Cut (1–15)' : '2nd Cut (16–31)';
      document.getElementById('page-sub').textContent = `📌 ${cutLabel}`;

      loadBills();
      loadLoans();
      initSession();
    });

    async function loadBills() {
      showEmpty('Loading…', '<span style="display:inline-block;width:18px;height:18px;border:2px solid var(--border);border-top-color:var(--primary);border-radius:50%;animation:spin .65s linear infinite;vertical-align:middle"></span>');
      try {
        const res = await fetch('/api/bills');
        bills = await res.json();
        if (bills.error) throw new Error(bills.error);
        render();
      } catch (e) {
        showEmpty('Cannot connect to server', 'Run: npm start  then open http://localhost:3000');
      }
    }

    // ── Navigation ────────────────────────────────────────────────
    document.querySelectorAll('.nav-item[data-page], .nav-sub-item[data-page], .mn-item[data-page]').forEach(btn => {
      btn.addEventListener('click', () => switchPage(btn.dataset.page));
    });

    function switchPage(page) {
      activePage = page;
      // Sync both sidebar nav and mobile bottom nav
      document.querySelectorAll('.nav-item[data-page], .nav-sub-item[data-page], .mn-item[data-page]').forEach(b =>
        b.classList.toggle('active', b.dataset.page === page));
      document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));
      document.getElementById('page-' + page).classList.add('active');
      const titles = { dashboard: 'Dashboard', bills: 'Bills Management', loans: 'Loan Tracker', users: 'User Management', groups: 'Group Management' };
      document.getElementById('page-title').textContent = titles[page] || page;
      if (page === 'bills') {
        const glabel = currentGroupName ? ` · 🏠 ${currentGroupName}` : '';
        document.getElementById('page-sub').textContent = `${bills.length} bills${glabel}`;
      } else if (page === 'loans') {
        const glabel = currentGroupName ? ` · 🏠 ${currentGroupName}` : '';
        document.getElementById('page-sub').textContent = `${loans.length} loans${glabel}`;
      } else if (page === 'users') {
        const pending = allUsers.filter(u => u.Status === 'Pending').length;
        document.getElementById('page-sub').textContent = pending > 0 ? `${pending} pending approval` : `${allUsers.length} users`;
      } else if (page === 'groups') {
        document.getElementById('page-sub').textContent = `${allGroups.length} groups`;
      } else {
        const cutLabel = dashFilterCutoff === '1-15' ? '1st Cut (1–15)' : dashFilterCutoff === '16-31' ? '2nd Cut (16–31)' : '';
        document.getElementById('page-sub').textContent = cutLabel ? `📌 ${cutLabel}` : '';
      }
    }

    // ── Helpers ───────────────────────────────────────────────────
    function matchesCutoff(bill, cutoff) {
      if (!cutoff) return true;
      if (!bill['Due Date']) return false;
      const day = new Date(bill['Due Date']).getDate();
      return cutoff === '1-15' ? day <= 15 : day >= 16;
    }

    // ── Computed ──────────────────────────────────────────────────
    function effectiveStatus(b) {
      if (b.Status === 'Paid') return 'Paid';
      const due = b['Due Date'] ? new Date(b['Due Date']) : null;
      if (due) due.setHours(0, 0, 0, 0);
      if (due && due < today()) return 'Overdue';
      return 'Unpaid';
    }
    function today() { const d = new Date(); d.setHours(0, 0, 0, 0); return d; }
    function daysUntil(dateStr) {
      if (!dateStr) return null;
      const d = new Date(dateStr); d.setHours(0, 0, 0, 0);
      return Math.ceil((d - today()) / 86400000);
    }

    // ── Render all ────────────────────────────────────────────────
    function render() {
      refreshMonthFilter();
      // Re-sync dropdowns with current filter state after options are rebuilt
      document.getElementById('dash-month').value = dashFilterMonth;
      document.getElementById('filter-cutoff').value = filterCutoff;
      updateDashboard();
      renderTable();
      updateNotifBadge();
      if (activePage !== 'bills') {
        const cutLabel = dashFilterCutoff === '1-15' ? '1st Cut (1–15)' : dashFilterCutoff === '16-31' ? '2nd Cut (16–31)' : '';
        document.getElementById('page-sub').textContent = cutLabel ? `📌 ${cutLabel}` : '';
      } else {
        const gl = currentGroupName ? ` · 🏠 ${currentGroupName}` : '';
        document.getElementById('page-sub').textContent = `${bills.length} bills${gl}`;
      }
    }

    // ── Dashboard ─────────────────────────────────────────────────
    function updateDashboard() {
      // Apply dashboard period filters
      let src = bills;
      if (dashFilterMonth) {
        src = src.filter(b => b['Due Date'] && b['Due Date'].slice(0, 7) === dashFilterMonth);
      }
      if (dashFilterCutoff) {
        src = src.filter(b => matchesCutoff(b, dashFilterCutoff));
      }
      // Update filter label
      const lbl = document.getElementById('dash-filter-label');
      const parts = [];
      if (dashFilterMonth) {
        const [y, mo] = dashFilterMonth.split('-');
        parts.push(new Date(y, mo - 1, 1).toLocaleDateString('en-PH', { month: 'long', year: 'numeric' }));
      }
      if (dashFilterCutoff) parts.push(dashFilterCutoff === '1-15' ? '1st Cut (1–15)' : '2nd Cut (16–31)');
      lbl.textContent = parts.length ? '📌 ' + parts.join(' · ') : '';

      const sum = arr => arr.reduce((s, b) => s + (parseFloat(b.Amount) || 0), 0);
      const paid = src.filter(b => effectiveStatus(b) === 'Paid');
      const unpaid = src.filter(b => effectiveStatus(b) === 'Unpaid');
      const overdue = src.filter(b => effectiveStatus(b) === 'Overdue');
      const remaining = [...unpaid, ...overdue];
      const now = new Date();
      const month = src.filter(b => {
        if (!b['Due Date']) return false;
        const d = new Date(b['Due Date']);
        return d.getMonth() === now.getMonth() && d.getFullYear() === now.getFullYear();
      });
      const week = src.filter(b => {
        const d = daysUntil(b['Due Date']);
        return effectiveStatus(b) !== 'Paid' && d !== null && d >= 0 && d <= 7;
      });
      const todayBills = src.filter(b =>
        effectiveStatus(b) !== 'Paid' && daysUntil(b['Due Date']) === 0);

      const totalAmt = sum(src);
      const paidAmt = sum(paid);
      const pct = totalAmt > 0 ? Math.round((paidAmt / totalAmt) * 100) : 0;

      // Hero
      setText('c-total', src.length);
      setText('c-total-amt', fmt(totalAmt));
      setText('c-paid', paid.length);
      setText('c-paid-amt', fmt(paidAmt));
      setText('c-paid-pct', pct + '%');
      setText('c-remain', remaining.length);
      setText('c-remain-amt', fmt(sum(remaining)));
      document.getElementById('c-paid-bar').style.width = pct + '%';
      document.getElementById('ps-bar').style.width = pct + '%';
      setText('ps-pct', pct + '%');
      setText('ps-text', fmt(paidAmt) + ' paid of ' + fmt(totalAmt));

      // Stats
      setText('c-overdue', overdue.length);
      setText('c-overdue-amt', fmt(sum(overdue)));
      setText('c-week', week.length);
      setText('c-week-amt', fmt(sum(week)));
      setText('c-today', todayBills.length);
      setText('c-today-amt', fmt(sum(todayBills)));
      setText('c-month', month.length);
      setText('c-month-amt', fmt(sum(month)));

      const show = (id, v) => document.getElementById(id).style.display = v ? '' : 'none';
      show('c-overdue-badge', overdue.length > 0);
      show('c-week-badge', week.length > 0);
      show('c-today-badge', todayBills.length > 0);
      document.querySelector('.sc-overdue .sc-icon').classList.toggle('sc-pulse', overdue.length > 0);

      // Nav badges — always based on all bills regardless of filter
      const allOverdue = bills.filter(b => effectiveStatus(b) === 'Overdue');
      const nb = document.getElementById('nav-overdue-badge');
      const mnb = document.getElementById('mn-overdue-badge');
      if (allOverdue.length > 0) {
        nb.textContent = allOverdue.length; nb.classList.add('show');
        mnb.textContent = allOverdue.length; mnb.classList.add('show');
      } else {
        nb.classList.remove('show');
        mnb.classList.remove('show');
      }

      // Alert strips
      const odEl = document.getElementById('alert-overdue');
      if (overdue.length > 0) {
        odEl.classList.add('visible');
        document.getElementById('alert-overdue-list').innerHTML =
          overdue.map(b => {
            const d = Math.abs(daysUntil(b['Due Date']));
            return `<span class="alert-pill">${esc(b['Bill Name'])} · ${d}d ago · ${fmt(b.Amount)}</span>`;
          }).join('');
      } else odEl.classList.remove('visible');

      const soon3 = src.filter(b => {
        const d = daysUntil(b['Due Date']);
        return effectiveStatus(b) !== 'Paid' && d !== null && d >= 0 && d <= 3;
      });
      const snEl = document.getElementById('alert-soon');
      if (soon3.length > 0) {
        snEl.classList.add('visible');
        document.getElementById('alert-soon-list').innerHTML =
          soon3.map(b => {
            const d = daysUntil(b['Due Date']);
            return `<span class="alert-pill">${esc(b['Bill Name'])} · ${d === 0 ? 'Today!' : d + 'd left'} · ${fmt(b.Amount)}</span>`;
          }).join('');
      } else snEl.classList.remove('visible');

      // Upcoming bills list (next 8, unpaid/overdue, sorted by due date)
      const upcoming = src
        .filter(b => effectiveStatus(b) !== 'Paid' && b['Due Date'])
        .sort((a, b) => new Date(a['Due Date']) - new Date(b['Due Date']))
        .slice(0, 8);
      const upEl = document.getElementById('upcoming-list');
      if (upcoming.length) {
        upEl.innerHTML = upcoming.map(b => {
          const d = daysUntil(b['Due Date']);
          const st = effectiveStatus(b);
          const dotClass = st === 'Overdue' ? 'dot-overdue' : d <= 3 ? 'dot-soon' : 'dot-upcoming';
          const badgeClass = st === 'Overdue' ? 'mb-overdue' : d === 0 ? 'mb-today' : d <= 3 ? 'mb-soon' : 'mb-upcoming';
          const badgeText = st === 'Overdue' ? Math.abs(d) + 'd ago' : d === 0 ? 'Today!' : d + 'd left';
          return `<div class="mini-row">
          <div class="mini-dot ${dotClass}"></div>
          <div class="mini-info">
            <div class="mini-name">${esc(b['Bill Name'])}</div>
            <div class="mini-meta">${esc(b.Category)} · ${fmtDate(b['Due Date'])}</div>
          </div>
          <span class="mini-amount">${fmt(b.Amount)}</span>
          <span class="mini-badge ${badgeClass}">${badgeText}</span>
        </div>`;
        }).join('');
      } else {
        upEl.innerHTML = '<div class="mini-empty">🎉 All bills are paid!</div>';
      }

      // Recent payments (last 8 paid, sorted by payment date desc)
      const recent = src
        .filter(b => b.Status === 'Paid' && b['Payment Date'])
        .sort((a, b) => new Date(b['Payment Date']) - new Date(a['Payment Date']))
        .slice(0, 8);
      const reEl = document.getElementById('recent-list');
      if (recent.length) {
        reEl.innerHTML = recent.map(b =>
          `<div class="mini-row">
          <div class="mini-dot dot-paid"></div>
          <div class="mini-info">
            <div class="mini-name">${esc(b['Bill Name'])}</div>
            <div class="mini-meta">${esc(b.Category)} · Paid ${fmtDate(b['Payment Date'])}</div>
          </div>
          <span class="mini-amount">${fmt(b.Amount)}</span>
          <span class="mini-badge mb-paid">Paid</span>
        </div>`
        ).join('');
      } else {
        reEl.innerHTML = '<div class="mini-empty">No payments recorded yet</div>';
      }
    }

    // ── Month filter ──────────────────────────────────────────────
    function refreshMonthFilter() {
      const months = [...new Set(
        bills.filter(b => b['Due Date']).map(b => b['Due Date'].slice(0, 7))
      )].sort();
      const makeOpts = (prefix) => months.map(m => {
        const [y, mo] = m.split('-');
        const label = new Date(y, mo - 1, 1).toLocaleDateString('en-PH', { month: 'long', year: 'numeric' });
        return `<option value="${m}">${label}</option>`;
      }).join('');

      // Bills page month filter
      const sel = document.getElementById('filter-month');
      const cur = sel.value;
      sel.innerHTML = '<option value="">📅 All Months</option>' + makeOpts();
      sel.value = cur;

      // Dashboard month filter
      const dashSel = document.getElementById('dash-month');
      const dashCur = dashSel.value;
      dashSel.innerHTML = '<option value="">All Months</option>' + makeOpts();
      dashSel.value = dashCur;
    }

    // ── Table ─────────────────────────────────────────────────────
    function renderTable() {
      const search = document.getElementById('filter-search').value.toLowerCase();
      const catFilter = document.getElementById('filter-category').value;
      const monthFilter = document.getElementById('filter-month').value;
      const cutoffFilter = document.getElementById('filter-cutoff').value;

      let filtered = bills.filter(b => {
        const st = effectiveStatus(b);
        if (filterStatus !== 'all' && st !== filterStatus) return false;
        if (catFilter && b.Category !== catFilter) return false;
        if (monthFilter && (!b['Due Date'] || b['Due Date'].slice(0, 7) !== monthFilter)) return false;
        if (cutoffFilter && !matchesCutoff(b, cutoffFilter)) return false;
        if (search && !b['Bill Name'].toLowerCase().includes(search)) return false;
        return true;
      });

      filtered.sort((a, b) => {
        let va = a[sortKey], vb = b[sortKey];
        if (sortKey === 'Amount') { va = parseFloat(va) || 0; vb = parseFloat(vb) || 0; }
        else if (sortKey === 'Due Date' || sortKey === 'Payment Date') {
          va = va ? new Date(va).getTime() : 0;
          vb = vb ? new Date(vb).getTime() : 0;
        } else { va = String(va || '').toLowerCase(); vb = String(vb || '').toLowerCase(); }
        return sortAsc ? (va < vb ? -1 : va > vb ? 1 : 0) : (va > vb ? -1 : va < vb ? 1 : 0);
      });

      const table = document.getElementById('bills-table');
      const emEl = document.getElementById('empty-msg');
      document.getElementById('row-count').textContent =
        filtered.length === bills.length ? `${bills.length} bills` : `${filtered.length} of ${bills.length}`;

      if (!filtered.length) {
        table.style.display = 'none'; emEl.style.display = '';
        showEmpty(!bills.length ? 'No bills yet' : 'No results', !bills.length ? 'Click "+ Add Bill" to start' : 'Adjust your filters');
        return;
      }
      emEl.style.display = 'none'; table.style.display = '';

      // Show/hide the Group column header based on whether data has _Group
      const hasGroup = filtered.length > 0 && filtered[0]._Group !== undefined;
      document.querySelectorAll('.th-group-col').forEach(th => th.style.display = hasGroup ? '' : 'none');
      const isAllGroupsView = hasGroup;

      document.getElementById('bills-body').innerHTML = filtered.map(b => {
        const st = effectiveStatus(b);
        const days = daysUntil(b['Due Date']);
        const rowC = st === 'Overdue' ? 'row-overdue' : st === 'Paid' ? 'row-paid'
          : (days !== null && days <= 7) ? 'row-due-soon' : '';
        const stC = st === 'Paid' ? 'st-paid' : st === 'Overdue' ? 'st-overdue' : 'st-unpaid';

        let dtag = '';
        if (st !== 'Paid' && days !== null) {
          if (days < 0) dtag = `<div><span class="date-tag dt-overdue">${Math.abs(days)}d overdue</span></div>`;
          else if (days === 0) dtag = `<div><span class="date-tag dt-today">Due Today!</span></div>`;
          else if (days <= 3) dtag = `<div><span class="date-tag dt-soon">${days}d left</span></div>`;
          else if (days <= 7) dtag = `<div><span class="date-tag dt-upcoming">${days}d left</span></div>`;
        }

        const payBtn = st !== 'Paid'
          ? `<button class="btn-ic bi-pay"  title="Mark Paid" onclick="markPaid(${b.ID})">✓</button>` : '';

        const attFile = b.Attachment;
        const proofCell = attFile
          ? `<div class="actions">
             <button class="btn-ic bi-att-view" title="View Proof" onclick="viewAttachment(${b.ID},'${esc(attFile)}')">🖼️</button>
             <button class="btn-ic bi-att" title="Replace Proof" onclick="triggerUpload(${b.ID})">📎</button>
           </div>`
          : `<button class="btn-ic bi-att" title="Upload Proof" onclick="triggerUpload(${b.ID})">📎</button>`;

        const recurTag = b.Recurrence
          ? `<span title="Recurring: ${b.Recurrence}" style="margin-left:4px;font-size:11px;background:#e0e7ff;color:#4f46e5;border-radius:5px;padding:1px 5px;font-weight:700">🔄 ${b.Recurrence}</span>`
          : '';
        const groupCell = isAllGroupsView
          ? `<td><span class="cat-badge" style="background:#ede9fe;color:#6d28d9">🏠 ${esc(b._Group || '—')}</span></td>`
          : '';
        const actionBtns = isAllGroupsView
          ? `<span style="font-size:11px;color:var(--muted)">Switch group to edit</span>`
          : `${payBtn}
             <button class="btn-ic bi-edit" title="Edit"   onclick="openEdit(${b.ID})">✏️</button>
             <button class="btn-ic bi-del"  title="Delete" onclick="askDelete(${b.ID},'${esc(b['Bill Name'])}')">🗑</button>`;
        return `<tr class="${rowC}">
        <td><div class="bill-name">${esc(b['Bill Name'])}${recurTag}</div><div class="bill-id">#${b.ID}</div></td>
        ${groupCell}
        <td><span class="cat-badge">${esc(b.Category)}</span></td>
        <td><span class="amount">${fmt(b.Amount)}</span></td>
        <td class="date-cell"><div class="date-main">${fmtDate(b['Due Date'])}</div>${dtag}</td>
        <td><span class="st-badge ${stC}">${st}</span></td>
        <td>${b['Payment Date'] ? `<span class="date-main">${fmtDate(b['Payment Date'])}</span>` : `<span class="muted-cell">—</span>`}</td>
        <td><span class="muted-cell">${esc(b.Notes) || '—'}</span></td>
        <td>${proofCell}</td>
        <td><div class="actions">${actionBtns}</div></td>
      </tr>`;
      }).join('');
    }

    function showEmpty(h, p) {
      const el = document.getElementById('empty-msg');
      el.innerHTML = `<div class="ei">📄</div><h3>${h}</h3><p>${p}</p>`;
      el.style.display = '';
    }

    function sortBy(k) {
      sortKey === k ? (sortAsc = !sortAsc) : (sortKey = k, sortAsc = true);
      renderTable();
    }

    // Status filter tabs — scoped to [data-filter] only
    document.querySelectorAll('.tab[data-filter]').forEach(btn => {
      btn.onclick = () => {
        document.querySelectorAll('.tab[data-filter]').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        filterStatus = btn.dataset.filter;
        renderTable();
      };
    });
    document.getElementById('filter-month').addEventListener('change', renderTable);
    document.getElementById('filter-cutoff').addEventListener('change', renderTable);
    document.getElementById('filter-category').addEventListener('change', renderTable);
    document.getElementById('filter-search').addEventListener('input', renderTable);

    // Dashboard period filter
    document.getElementById('dash-month').addEventListener('change', () => {
      dashFilterMonth = document.getElementById('dash-month').value;
      updateDashboard();
    });
    document.querySelectorAll('[data-dashcut]').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('[data-dashcut]').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        dashFilterCutoff = btn.dataset.dashcut;
        updateDashboard();
        const cutLabel = dashFilterCutoff === '1-15' ? '1st Cut (1–15)' : dashFilterCutoff === '16-31' ? '2nd Cut (16–31)' : '';
        document.getElementById('page-sub').textContent = cutLabel ? `📌 ${cutLabel}` : '';
      });
    });

    // ── Mark Paid ─────────────────────────────────────────────────
    function nextRecurringDate(dueDateStr, recurrence) {
      const d = new Date(dueDateStr);
      switch (recurrence) {
        case 'weekly': d.setDate(d.getDate() + 7); break;
        case 'monthly': d.setMonth(d.getMonth() + 1); break;
        case 'bimonthly': d.setMonth(d.getMonth() + 2); break;
        case 'yearly': d.setFullYear(d.getFullYear() + 1); break;
      }
      return d.toISOString().slice(0, 10);
    }

    async function markPaid(id) {
      const t = new Date().toISOString().slice(0, 10);
      try {
        const res = await fetch('/api/bills/' + id, {
          method: 'PUT', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ Status: 'Paid', 'Payment Date': t })
        });
        const u = await res.json();
        if (u.error) throw new Error(u.error);
        const i = bills.findIndex(b => b.ID == id);
        if (i !== -1) bills[i] = u;

        // Auto-create next bill for recurring entries
        if (u.Recurrence && u['Due Date']) {
          const nextDue = nextRecurringDate(u['Due Date'], u.Recurrence);
          const payload = {
            'Bill Name': u['Bill Name'],
            Category: u.Category,
            Amount: u.Amount,
            'Due Date': nextDue,
            Status: 'Unpaid',
            'Payment Date': '',
            Notes: u.Notes,
            Recurrence: u.Recurrence
          };
          const r2 = await fetch('/api/bills', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload) });
          const nb = await r2.json();
          if (!nb.error) bills.push(nb);
          render();
          toast('✅ Paid! Next due ' + fmtDate(nextDue) + ' created 🔄');
        } else {
          render();
          toast('✅ Marked as Paid!');
        }
      } catch (e) { toast('❌ ' + e.message); }
    }

    // ── Add / Edit modal ──────────────────────────────────────────
    document.getElementById('btn-add-bill').onclick = () => {
      editId = null;
      setText('modal-title', 'Add New Bill');
      document.getElementById('btn-modal-save').textContent = 'Add Bill';
      clearForm();
      document.getElementById('modal-overlay').classList.add('open');
      document.getElementById('f-name').focus();
    };

    function openEdit(id) {
      const b = bills.find(b => b.ID == id); if (!b) return;
      editId = id;
      setText('modal-title', 'Edit Bill');
      document.getElementById('btn-modal-save').textContent = 'Save Changes';
      document.getElementById('f-name').value = b['Bill Name'] || '';
      document.getElementById('f-category').value = b.Category || 'Others';
      document.getElementById('f-amount').value = b.Amount || '';
      document.getElementById('f-due').value = b['Due Date'] || '';
      document.getElementById('f-status').value = b.Status || 'Unpaid';
      document.getElementById('f-paydate').value = b['Payment Date'] || '';
      document.getElementById('f-notes').value = b.Notes || '';
      document.getElementById('f-recurrence').value = b.Recurrence || '';
      document.getElementById('modal-overlay').classList.add('open');
    }

    document.getElementById('btn-modal-save').onclick = async () => {
      const name = document.getElementById('f-name').value.trim();
      const due = document.getElementById('f-due').value;
      if (!name) { toast('⚠️ Bill Name is required'); return; }
      if (!due) { toast('⚠️ Due Date is required'); return; }
      const payload = {
        'Bill Name': name,
        Category: document.getElementById('f-category').value,
        Amount: parseFloat(document.getElementById('f-amount').value) || 0,
        'Due Date': due,
        Status: document.getElementById('f-status').value,
        'Payment Date': document.getElementById('f-paydate').value,
        Notes: document.getElementById('f-notes').value.trim(),
        Recurrence: document.getElementById('f-recurrence').value
      };
      const btn = document.getElementById('btn-modal-save');
      btnLoad(btn, true, 'Saving…');
      try {
        if (editId === null) {
          const r = await fetch('/api/bills', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload) });
          const nb = await r.json(); if (nb.error) throw new Error(nb.error);
          bills.push(nb); toast('🎉 Bill added!');
        } else {
          const r = await fetch('/api/bills/' + editId, { method: 'PUT', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload) });
          const u = await r.json(); if (u.error) throw new Error(u.error);
          const i = bills.findIndex(b => b.ID == editId); if (i !== -1) bills[i] = u;
          toast('✏️ Bill updated!');
        }
        document.getElementById('modal-overlay').classList.remove('open');
        render();
      } catch (e) { toast('❌ ' + e.message); }
      finally { btnLoad(btn, false); }
    };

    document.getElementById('btn-modal-cancel').onclick = () =>
      document.getElementById('modal-overlay').classList.remove('open');
    document.getElementById('modal-overlay').addEventListener('click', e => {
      if (e.target.id === 'modal-overlay') document.getElementById('modal-overlay').classList.remove('open');
    });

    // ── Delete ────────────────────────────────────────────────────
    function askDelete(id, name) {
      deleteId = id;
      deleteContext = 'bill';
      document.getElementById('confirm-msg').textContent = `"${name}" will be permanently deleted.`;
      document.getElementById('confirm-overlay').classList.add('open');
    }
    document.getElementById('btn-yes').onclick = async () => {
      const btn = document.getElementById('btn-yes');
      document.getElementById('confirm-overlay').classList.remove('open');
      btnLoad(btn, true, 'Deleting…');
      try {
        if (deleteContext === 'loan') {
          await fetch('/api/loans/' + deleteLoanId, { method: 'DELETE' });
          loans = loans.filter(l => l.ID != deleteLoanId);
          loanPayments = loanPayments.filter(p => String(p['Loan ID']) !== String(deleteLoanId));
          renderLoans();
          toast('🗑️ Loan deleted.');
        } else {
          await fetch('/api/bills/' + deleteId, { method: 'DELETE' });
          bills = bills.filter(b => b.ID != deleteId);
          render();
          toast('🗑️ Deleted.');
        }
      } catch (e) { toast('❌ ' + e.message); }
      finally { btnLoad(btn, false); }
    };
    document.getElementById('btn-no').onclick = () =>
      document.getElementById('confirm-overlay').classList.remove('open');

    // ── Attachments ───────────────────────────────────────────────
    function triggerUpload(id) {
      attBillId = id;
      const inp = document.getElementById('att-file-input');
      inp.value = '';
      inp.click();
    }

    document.getElementById('att-file-input').addEventListener('change', async (e) => {
      const file = e.target.files[0];
      if (!file || !attBillId) return;
      const fd = new FormData();
      fd.append('file', file);
      try {
        const res = await fetch('/api/bills/' + attBillId + '/attachment', { method: 'POST', body: fd });
        const data = await res.json();
        if (data.error) throw new Error(data.error);
        const i = bills.findIndex(b => b.ID == attBillId);
        if (i !== -1) bills[i].Attachment = data.filename;
        render();
        toast('📎 Proof uploaded!');
      } catch (err) { toast('❌ ' + err.message); }
    });

    function viewAttachment(id, filename) {
      attBillId = id;
      const url = '/uploads/' + filename;
      const isPDF = filename.toLowerCase().endsWith('.pdf');
      const lb = document.getElementById('lightbox-overlay');
      const body = document.getElementById('lb-body');
      const dlBtn = document.getElementById('lb-download');

      document.getElementById('lb-title').textContent = '📎 ' + filename;
      dlBtn.href = url;
      dlBtn.download = filename;

      if (isPDF) {
        body.className = 'lb-pdf-wrap';
        body.innerHTML = `<a class="lb-pdf-link" href="${url}" target="_blank">📄 Open PDF in new tab</a>`;
      } else {
        body.className = 'lb-image-wrap';
        body.innerHTML = `<img id="lb-img" src="${url}" alt="Payment proof"
        onerror="this.parentNode.innerHTML='<p style=color:rgba(255,255,255,.5);font-size:14px>⚠️ Cannot load image</p>'">`;
        // Toggle zoom on click
        body.onclick = () => body.classList.toggle('zoomed');
      }
      lb.classList.add('open');
    }

    function closeLightbox() {
      document.getElementById('lightbox-overlay').classList.remove('open');
      document.getElementById('lb-body').innerHTML = '';
      document.getElementById('lb-body').className = '';
    }
    document.addEventListener('keydown', e => {
      if (e.key === 'Escape' && document.getElementById('lightbox-overlay').classList.contains('open')) closeLightbox();
    });

    document.getElementById('lb-close').addEventListener('click', closeLightbox);

    // Close on dark backdrop click (not on toolbar or image)
    document.getElementById('lightbox-overlay').addEventListener('click', e => {
      if (e.target.id === 'lightbox-overlay') closeLightbox();
    });

    document.getElementById('lb-remove').addEventListener('click', async () => {
      if (!attBillId) return;
      if (!confirm('Remove this proof image?')) return;
      try {
        await fetch('/api/bills/' + attBillId + '/attachment', { method: 'DELETE' });
        const i = bills.findIndex(b => b.ID == attBillId);
        if (i !== -1) bills[i].Attachment = '';
        closeLightbox();
        render();
        toast('🗑️ Proof removed.');
      } catch (err) { toast('❌ ' + err.message); }
    });

    // ── Helpers ───────────────────────────────────────────────────
    function clearForm() {
      ['f-name', 'f-amount', 'f-due', 'f-paydate', 'f-notes'].forEach(id => document.getElementById(id).value = '');
      document.getElementById('f-category').value = 'Utilities';
      document.getElementById('f-status').value = 'Unpaid';
      document.getElementById('f-recurrence').value = '';
    }
    function fmt(v) {
      return '₱' + (parseFloat(v) || 0).toLocaleString('en-PH', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    }
    function fmtDate(v) {
      if (!v) return '—';
      const d = new Date(v); if (isNaN(d)) return v;
      return d.toLocaleDateString('en-PH', { year: 'numeric', month: 'short', day: 'numeric' });
    }
    function setText(id, v) { const el = document.getElementById(id); if (el) el.textContent = v; }
    function esc(s) {
      return String(s || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;').replace(/'/g, '&#39;');
    }
    let toastTimer;
    function toast(msg) {
      const el = document.getElementById('toast');
      el.textContent = msg; el.classList.add('show');
      clearTimeout(toastTimer);
      toastTimer = setTimeout(() => el.classList.remove('show'), 3000);
    }
    function btnLoad(btn, loading, loadingText) {
      if (loading) {
        btn.dataset.origText = btn.innerHTML;
        btn.innerHTML = loadingText || 'Saving…';
        btn.classList.add('btn-spin');
        btn.disabled = true;
      } else {
        if (btn.dataset.origText) btn.innerHTML = btn.dataset.origText;
        btn.classList.remove('btn-spin');
        btn.disabled = false;
      }
    }

    // ════════════════════════════════════════
    //  LOANS
    // ════════════════════════════════════════

    async function loadLoans() {
      try {
        const [lr, pr] = await Promise.all([
          fetch('/api/loans').then(r => r.json()),
          fetch('/api/loan-payments').then(r => r.json())
        ]);
        if (lr.error) throw new Error(lr.error);
        if (pr.error) throw new Error(pr.error);
        loans = lr; loanPayments = pr;
        renderLoans();
      } catch (e) { /* silent — server may not have loans yet */ }
    }

    // ── Loan computed ─────────────────────────────────────────────
    function loanPmts(id) {
      return loanPayments.filter(p => String(p['Loan ID']) === String(id));
    }
    function loanTotalPaid(id) {
      return loanPmts(id).reduce((s, p) => s + (parseFloat(p.Amount) || 0), 0);
    }
    function dayOrdinal(n) {
      n = parseInt(n); if (!n) return '';
      const s = ['th', 'st', 'nd', 'rd'], v = n % 100;
      return n + (s[(v - 20) % 10] || s[v] || s[0]);
    }
    function effectiveLoanStatus(loan) {
      const paid = loanTotalPaid(loan.ID);
      const principal = parseFloat(loan.Principal) || 0;
      if (principal > 0 && paid >= principal) return 'Paid Off';
      const dueDay = parseInt(loan['Due Day']) || 0;
      if (dueDay > 0) {
        const now = new Date();
        const due = new Date(now.getFullYear(), now.getMonth(), dueDay);
        due.setHours(0, 0, 0, 0);
        const td = new Date(); td.setHours(0, 0, 0, 0);
        if (td > due) {
          const mo = now.toISOString().slice(0, 7);
          const paidMo = loanPayments.some(p =>
            String(p['Loan ID']) === String(loan.ID) &&
            p['Payment Date'] && p['Payment Date'].slice(0, 7) === mo
          );
          if (!paidMo) return 'Overdue';
        }
      }
      return 'Active';
    }

    // ── Loan KPIs ─────────────────────────────────────────────────
    function updateLoanKPIs() {
      const totalP = loans.reduce((s, l) => s + (parseFloat(l.Principal) || 0), 0);
      const totalPaid = loans.reduce((s, l) => s + loanTotalPaid(l.ID), 0);
      const outstanding = Math.max(0, totalP - totalPaid);
      const overdueN = loans.filter(l => effectiveLoanStatus(l) === 'Overdue').length;
      const pct = totalP > 0 ? Math.min(100, Math.round((totalPaid / totalP) * 100)) : 0;
      setText('l-total-amt', fmt(totalP));
      setText('l-total-count', loans.length);
      setText('l-paid-amt', fmt(totalPaid));
      setText('l-outstanding-amt', fmt(outstanding));
      setText('l-overdue-count', overdueN);
      setText('l-progress-pct', pct + '%');
      const bar = document.getElementById('l-progress-bar');
      if (bar) bar.style.width = pct + '%';
    }

    // ── Render loan table ─────────────────────────────────────────
    function renderLoans() {
      updateLoanKPIs();
      const search = (document.getElementById('loan-search').value || '').toLowerCase();
      const filtered = loans.filter(l => {
        const st = effectiveLoanStatus(l);
        if (loanFilterStatus !== 'all' && st !== loanFilterStatus) return false;
        if (search && !String(l['Loan Name'] || '').toLowerCase().includes(search) &&
          !String(l.Lender || '').toLowerCase().includes(search)) return false;
        return true;
      });
      const table = document.getElementById('loans-table');
      const emEl = document.getElementById('loans-empty');
      document.getElementById('loan-row-count').textContent =
        filtered.length === loans.length ? `${loans.length} loans` : `${filtered.length} of ${loans.length}`;
      if (!filtered.length) {
        table.style.display = 'none'; emEl.style.display = '';
        emEl.innerHTML = `<div class="ei">${loans.length ? '🔍' : '💳'}</div>
        <h3>${loans.length ? 'No results' : 'No loans yet'}</h3>
        <p>${loans.length ? 'Adjust your filters' : 'Click "＋ Add Loan" to start'}</p>`;
        return;
      }
      emEl.style.display = 'none'; table.style.display = '';
      const hasLoanGroup = filtered.length > 0 && filtered[0]._Group !== undefined;
      document.querySelectorAll('.th-group-col').forEach(th => th.style.display = hasLoanGroup ? '' : 'none');
      const isAllGroupsLoan = hasLoanGroup;
      document.getElementById('loans-body').innerHTML = filtered.map(l => {
        const st = effectiveLoanStatus(l);
        const principal = parseFloat(l.Principal) || 0;
        const paid = loanTotalPaid(l.ID);
        const remaining = Math.max(0, principal - paid);
        const pct = principal > 0 ? Math.min(100, Math.round((paid / principal) * 100)) : 0;
        const monthly = parseFloat(l['Monthly Payment']) || 0;
        const rowCls = st === 'Overdue' ? 'row-overdue' : st === 'Paid Off' ? 'row-paid' : '';
        const stCls = st === 'Paid Off' ? 'st-paid' : st === 'Overdue' ? 'st-overdue' : 'st-unpaid';
        const barClr = pct >= 100 ? 'var(--success)' : pct >= 50 ? 'var(--primary)' : 'var(--warning)';
        const lGroupCell = isAllGroupsLoan
          ? `<td><span class="cat-badge" style="background:#ede9fe;color:#6d28d9">🏠 ${esc(l._Group || '—')}</span></td>`
          : '';
        return `<tr class="${rowCls}">
        <td>
          <div class="bill-name">${esc(l['Loan Name'])}</div>
          <div class="bill-id">#${l.ID}${l['Start Date'] ? ' · ' + fmtDate(l['Start Date']) : ''}</div>
        </td>
        ${lGroupCell}
        <td><span class="muted-cell">${esc(l.Lender || '—')}</span></td>
        <td>
          <span class="amount">${fmt(principal)}</span>
          ${l.Terms ? '<div class="bill-id">' + esc(l.Terms) + ' months</div>' : ''}
        </td>
        <td>
          ${monthly ? '<span class="amount" style="font-size:13px">' + fmt(monthly) + '</span>' : '<span class="muted-cell">—</span>'}
          ${l['Due Day'] ? '<div class="bill-id">due ' + dayOrdinal(l['Due Day']) + '</div>' : ''}
        </td>
        <td style="min-width:140px">
          <div style="display:flex;justify-content:space-between;font-size:11px;margin-bottom:4px">
            <span style="font-weight:700;color:var(--success)">${fmt(paid)}</span>
            <span style="color:var(--muted)">${pct}%</span>
          </div>
          <div style="background:var(--bg);border-radius:99px;height:6px;overflow:hidden">
            <div style="height:100%;border-radius:99px;background:${barClr};width:${pct}%;transition:width .5s"></div>
          </div>
        </td>
        <td><span class="amount" style="font-size:13px;color:${remaining > 0 ? 'var(--warning)' : 'var(--success)'}">${fmt(remaining)}</span></td>
        <td><span class="st-badge ${stCls}">${st}</span></td>
        <td><div class="actions">
          ${isAllGroupsLoan
            ? `<span style="font-size:11px;color:var(--muted)">Switch group to edit</span>`
            : `<button class="btn-ic" style="background:#e0f2fe;color:#0369a1;width:auto;padding:0 10px;font-size:11px;font-weight:700;border-radius:7px" onclick="openLoanPayments(${l.ID})" title="Payments">💳 Pay</button>
               <button class="btn-ic bi-edit" onclick="openEditLoan(${l.ID})" title="Edit">✏️</button>
               <button class="btn-ic bi-del"  onclick="askDeleteLoan(${l.ID},'${esc(l['Loan Name'])}')" title="Delete">🗑</button>`}
        </div></td>
      </tr>`;
      }).join('');
    }

    // ── Add / Edit loan ───────────────────────────────────────────
    document.getElementById('btn-add-loan').onclick = () => {
      editLoanId = null;
      setText('loan-modal-title', 'Add New Loan');
      document.getElementById('btn-loan-save').textContent = 'Add Loan';
      ['lf-name', 'lf-lender', 'lf-principal', 'lf-monthly', 'lf-terms', 'lf-dueday', 'lf-startdate', 'lf-notes']
        .forEach(id => document.getElementById(id).value = '');
      document.getElementById('loan-modal-overlay').classList.add('open');
      document.getElementById('lf-name').focus();
    };

    function openEditLoan(id) {
      const l = loans.find(x => x.ID == id); if (!l) return;
      editLoanId = id;
      setText('loan-modal-title', 'Edit Loan');
      document.getElementById('btn-loan-save').textContent = 'Save Changes';
      document.getElementById('lf-name').value = l['Loan Name'] || '';
      document.getElementById('lf-lender').value = l.Lender || '';
      document.getElementById('lf-principal').value = l.Principal || '';
      document.getElementById('lf-monthly').value = l['Monthly Payment'] || '';
      document.getElementById('lf-terms').value = l.Terms || '';
      document.getElementById('lf-dueday').value = l['Due Day'] || '';
      document.getElementById('lf-startdate').value = l['Start Date'] || '';
      document.getElementById('lf-notes').value = l.Notes || '';
      document.getElementById('loan-modal-overlay').classList.add('open');
    }

    document.getElementById('btn-loan-save').onclick = async () => {
      const name = document.getElementById('lf-name').value.trim();
      const lender = document.getElementById('lf-lender').value.trim();
      const principal = parseFloat(document.getElementById('lf-principal').value);
      if (!name) { toast('⚠️ Loan Name is required'); return; }
      if (!lender) { toast('⚠️ Lender is required'); return; }
      if (!principal) { toast('⚠️ Principal amount is required'); return; }
      const payload = {
        'Loan Name': name, Lender: lender, Principal: principal,
        'Monthly Payment': parseFloat(document.getElementById('lf-monthly').value) || 0,
        Terms: document.getElementById('lf-terms').value.trim() || '',
        'Start Date': document.getElementById('lf-startdate').value || '',
        'Due Day': document.getElementById('lf-dueday').value || '',
        Notes: document.getElementById('lf-notes').value.trim() || ''
      };
      const btn = document.getElementById('btn-loan-save');
      btnLoad(btn, true, 'Saving…');
      try {
        if (editLoanId === null) {
          const r = await fetch('/api/loans', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload) });
          const nl = await r.json(); if (nl.error) throw new Error(nl.error);
          loans.push(nl); toast('🎉 Loan added!');
        } else {
          const r = await fetch('/api/loans/' + editLoanId, { method: 'PUT', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload) });
          const ul = await r.json(); if (ul.error) throw new Error(ul.error);
          const i = loans.findIndex(x => x.ID == editLoanId); if (i !== -1) loans[i] = ul;
          toast('✏️ Loan updated!');
        }
        document.getElementById('loan-modal-overlay').classList.remove('open');
        renderLoans();
        const gl2 = currentGroupName ? ` · 🏠 ${currentGroupName}` : '';
        document.getElementById('page-sub').textContent = `${loans.length} loans${gl2}`;
      } catch (e) { toast('❌ ' + e.message); }
      finally { btnLoad(btn, false); }
    };

    document.getElementById('btn-loan-cancel').onclick = () =>
      document.getElementById('loan-modal-overlay').classList.remove('open');

    // ── Delete loan ───────────────────────────────────────────────
    function askDeleteLoan(id, name) {
      deleteLoanId = id;
      deleteContext = 'loan';
      document.getElementById('confirm-msg').textContent = `"${name}" and all its payments will be permanently deleted.`;
      document.getElementById('confirm-overlay').classList.add('open');
    }

    // ── Loan payments modal ───────────────────────────────────────
    function openLoanPayments(id) {
      const l = loans.find(x => x.ID == id); if (!l) return;
      viewLoanId = id;
      setText('pmt-loan-name', '💳 ' + l['Loan Name']);
      document.getElementById('pf-date').value = new Date().toISOString().slice(0, 10);
      document.getElementById('pf-amount').value = l['Monthly Payment'] || '';
      document.getElementById('pf-notes').value = '';
      refreshPmtModal(id);
      document.getElementById('loan-pmt-overlay').classList.add('open');
    }

    function refreshPmtModal(id) {
      const l = loans.find(x => x.ID == id); if (!l) return;
      const principal = parseFloat(l.Principal) || 0;
      const paid = loanTotalPaid(id);
      const remaining = Math.max(0, principal - paid);
      const pct = principal > 0 ? Math.min(100, Math.round((paid / principal) * 100)) : 0;
      setText('pmt-paid-label', fmt(paid) + ' paid');
      setText('pmt-remaining-label', fmt(remaining) + ' remaining');
      setText('pmt-pct-label', pct + '%');
      document.getElementById('pmt-progress').style.width = pct + '%';
      // Payment list
      const pmts = loanPmts(id).sort((a, b) => new Date(b['Payment Date']) - new Date(a['Payment Date']));
      const list = document.getElementById('pmt-list');
      if (!pmts.length) {
        list.innerHTML = '<div class="pmt-empty">No payments recorded yet. Add one above!</div>';
        return;
      }
      list.innerHTML = pmts.map(p => `
      <div class="pmt-row">
        <span class="pmt-date">📅 ${fmtDate(p['Payment Date'])}</span>
        <span class="pmt-amt">${fmt(p.Amount)}</span>
        <span class="pmt-note">${esc(p.Notes) || '—'}</span>
        <button class="btn-ic bi-del" style="flex-shrink:0;font-size:12px" title="Delete" onclick="deleteLoanPayment(${p.ID})">🗑</button>
      </div>`).join('');
    }

    document.getElementById('btn-add-payment').onclick = async () => {
      const amount = parseFloat(document.getElementById('pf-amount').value);
      const date = document.getElementById('pf-date').value;
      if (!amount || amount <= 0) { toast('⚠️ Amount is required'); return; }
      if (!date) { toast('⚠️ Payment date is required'); return; }
      const payload = {
        'Loan ID': viewLoanId, Amount: amount,
        'Payment Date': date,
        Notes: document.getElementById('pf-notes').value.trim()
      };
      const btn = document.getElementById('btn-add-payment');
      btnLoad(btn, true, '✅ Recording…');
      try {
        const r = await fetch('/api/loan-payments', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload) });
        const np = await r.json(); if (np.error) throw new Error(np.error);
        loanPayments.push(np);
        document.getElementById('pf-amount').value = '';
        document.getElementById('pf-notes').value = '';
        refreshPmtModal(viewLoanId);
        renderLoans();
        toast('✅ Payment recorded!');
      } catch (e) { toast('❌ ' + e.message); }
      finally { btnLoad(btn, false); }
    };

    async function deleteLoanPayment(pmtId) {
      if (!confirm('Delete this payment record?')) return;
      try {
        await fetch('/api/loan-payments/' + pmtId, { method: 'DELETE' });
        loanPayments = loanPayments.filter(p => p.ID != pmtId);
        refreshPmtModal(viewLoanId);
        renderLoans();
        toast('🗑️ Payment deleted.');
      } catch (e) { toast('❌ ' + e.message); }
    }

    document.getElementById('btn-pmt-close').onclick = () =>
      document.getElementById('loan-pmt-overlay').classList.remove('open');

    // ── Logout ────────────────────────────────────────────────────
    function toggleNavGroup() {
      const group = document.getElementById('nav-admin-group');
      group.classList.toggle('open');
    }

    async function doLogout() {
      try { await fetch('/api/logout', { method: 'POST' }); } finally {
        window.location.href = '/login';
      }
    }

    // ════════════════════════════════════════
    //  USERS (admin)
    // ════════════════════════════════════════
    let allUsers = [];
    let userFilter = 'all';
    let isAdminSession = false;
    let allGroups = [];
    let currentGroupName = '';
    let currentGroupCode = '';

    async function initSession() {
      try {
        const res = await fetch('/api/me');
        const data = await res.json();
        isAdminSession = data.isAdmin || false;
        currentGroupName = data.groupName || 'Admin';
        currentGroupCode = data.groupCode || 'admin';

        const wrap = document.getElementById('group-switcher-wrap');
        wrap.style.display = '';

        if (isAdminSession) {
          document.getElementById('nav-admin-group').style.display = '';
          document.getElementById('mn-users').style.display = '';
          document.getElementById('mn-groups').style.display = '';
          loadUsers();
          await loadGroups();          // populate switcher first
          buildGroupSwitcher();        // then render the select
        } else {
          // Non-admin: static badge showing their household
          const badge = document.getElementById('group-badge');
          badge.textContent = '🏠 ' + currentGroupName;
          badge.style.display = '';
          // Also show in sidebar footer
          const footer = document.querySelector('.sidebar-footer');
          const chip = document.createElement('div');
          chip.style.cssText = 'margin-top:6px;font-size:11px;color:rgba(255,255,255,.55);';
          chip.textContent = '🏠 ' + currentGroupName;
          footer.insertBefore(chip, footer.firstChild);
        }
      } catch { /* not admin or error */ }
    }

    function buildGroupSwitcher() {
      const sel = document.getElementById('group-switcher-select');
      sel.innerHTML =
        '<option value="__all__">📊 All Groups</option>' +
        '<option value="admin">🛡️ Admin (my data)</option>' +
        allGroups.map(g => `<option value="${g.Code}">🏠 ${g.Name}</option>`).join('');
      sel.value = currentGroupCode || '__all__';
      sel.style.display = '';
    }

    async function switchGroup(code) {
      const sel = document.getElementById('group-switcher-select');
      sel.disabled = true;
      try {
        // Tell server to change the active data file for this session
        const r = await fetch('/api/switch-group', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ groupCode: code })
        });
        const d = await r.json();
        if (d.error) throw new Error(d.error);
        currentGroupCode = code;
        currentGroupName = d.groupName;
        // Reload both data sets with the new group's file, then navigate to Bills
        await Promise.all([loadBills(), loadLoans()]);
        switchPage('bills');
        toast('🏠 Viewing: ' + d.groupName);
      } catch (e) {
        toast('❌ ' + e.message);
        sel.value = currentGroupCode; // revert dropdown on error
      } finally {
        sel.disabled = false;
      }
    }

    async function loadUsers() {
      try {
        const res = await fetch('/api/users');
        allUsers = await res.json();
        renderUsers();
        const pending = allUsers.filter(u => u.Status === 'Pending').length;
        const nb = document.getElementById('nav-pending-badge');
        const mnb = document.getElementById('mn-pending-badge');
        if (pending > 0) {
          nb.textContent = pending; nb.classList.add('show');
          mnb.textContent = pending; mnb.classList.add('show');
        } else {
          nb.classList.remove('show');
          mnb.classList.remove('show');
        }
      } catch (e) { toast('❌ Could not load users'); }
    }

    function renderUsers() {
      const filtered = userFilter === 'all'
        ? allUsers
        : allUsers.filter(u => (u.Status || 'Active') === userFilter);

      document.getElementById('users-count').textContent =
        filtered.length === allUsers.length
          ? `${allUsers.length} users`
          : `${filtered.length} of ${allUsers.length}`;

      const table = document.getElementById('users-table');
      const emEl = document.getElementById('users-empty');
      if (!filtered.length) {
        table.style.display = 'none'; emEl.style.display = '';
        return;
      }
      emEl.style.display = 'none'; table.style.display = '';

      document.getElementById('users-body').innerHTML = filtered.map(u => {
        const st = u.Status || 'Active';
        const stColor = st === 'Active' ? 'st-paid'
          : st === 'Pending' ? 'st-unpaid'
            : 'st-overdue';
        const stIcon = st === 'Active' ? '✅'
          : st === 'Pending' ? '⏳'
            : '🚫';
        const date = u.CreatedAt ? new Date(u.CreatedAt).toLocaleDateString('en-PH', { year: 'numeric', month: 'short', day: 'numeric' }) : '—';
        const isAdmin = u.Username.toLowerCase() === 'admin';

        const actions = isAdmin ? `
          <button class="btn-ic bi-edit" title="Change Password" onclick="openResetPw(${u.ID},'${esc(u.Username)}')">🔒</button>
        ` : `
          ${st === 'Pending' ? `<button class="btn-ic bi-pay"  title="Approve" onclick="openApproveConfirm(${u.ID},'${esc(u.Username)}','${esc(u.GroupCode || '')}','${esc(u.GroupName || u.GroupCode || '')}')">✓</button>` : ''}
          ${st === 'Active' ? `<button class="btn-ic bi-edit" title="Revoke"  onclick="rejectUser(${u.ID},'${esc(u.Username)}')">🚫</button>` : ''}
          ${st === 'Rejected' ? `<button class="btn-ic bi-pay"  title="Approve" onclick="openApproveConfirm(${u.ID},'${esc(u.Username)}','${esc(u.GroupCode || '')}','${esc(u.GroupName || u.GroupCode || '')}')">✓</button>` : ''}
          ${st === 'Pending' ? `<button class="btn-ic bi-del"  title="Reject"  onclick="rejectUser(${u.ID},'${esc(u.Username)}')">✗</button>` : ''}
          <button class="btn-ic" title="Change Group" style="background:#ede9fe;color:#6d28d9" onclick="openChangeGroup(${u.ID},'${esc(u.Username)}','${esc(u.GroupCode || '')}')">🏠</button>
          <button class="btn-ic bi-edit" title="Reset Password" onclick="openResetPw(${u.ID},'${esc(u.Username)}')">🔒</button>
          <button class="btn-ic bi-del"  title="Delete"         onclick="deleteUser(${u.ID},'${esc(u.Username)}')">🗑</button>
        `;
        const groupLabel = u.GroupName || u.GroupCode || '—';
        return `<tr>
          <td><span class="bill-id">#${u.ID}</span></td>
          <td><div class="bill-name">${esc(u.Username)}</div></td>
          <td><span class="muted-cell">🏠 ${esc(groupLabel)}</span></td>
          <td><span class="st-badge ${stColor}">${stIcon} ${st}</span></td>
          <td><span class="muted-cell">${date}</span></td>
          <td><div class="actions">${actions}</div></td>
        </tr>`;
      }).join('');
    }

    let _approveId = null, _approveName = '';

    async function openApproveConfirm(id, name, groupCode, groupName) {
      _approveId = id;
      _approveName = name;

      document.getElementById('approveconfirm-sub').textContent =
        `Reviewing membership for: ${name}`;
      document.getElementById('approveconfirm-alert').style.display = 'none';

      // populate group dropdown
      const sel = document.getElementById('approveconfirm-group');
      sel.innerHTML = '<option value="">Loading…</option>';
      try {
        const res = await fetch('/api/groups');
        const groups = await res.json();
        sel.innerHTML = groups.map(g =>
          `<option value="${esc(g.Code)}" ${g.Code === groupCode ? 'selected' : ''}>${esc(g.Name)}</option>`
        ).join('');
        if (!sel.value && groups.length) sel.value = groups[0].Code;
      } catch {
        sel.innerHTML = '<option value="">Cannot load groups</option>';
      }

      document.getElementById('approveconfirm-overlay').classList.add('open');
    }

    async function saveApproveConfirm() {
      const groupCode = document.getElementById('approveconfirm-group').value;
      const alertEl = document.getElementById('approveconfirm-alert');
      if (!groupCode) {
        alertEl.textContent = 'Please select a group before approving.';
        alertEl.style.display = 'block';
        return;
      }
      alertEl.style.display = 'none';

      const btn = document.getElementById('btn-approveconfirm-save');
      btnLoad(btn, true, '…');
      try {
        // 1. update group if needed
        const rg = await fetch('/api/users/' + _approveId + '/group', {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ groupCode })
        });
        const dg = await rg.json(); if (dg.error) throw new Error(dg.error);

        // 2. approve
        const r = await fetch('/api/users/' + _approveId + '/approve', { method: 'PUT' });
        const d = await r.json(); if (d.error) throw new Error(d.error);

        document.getElementById('approveconfirm-overlay').classList.remove('open');
        toast('✅ ' + _approveName + ' approved!');
        await loadUsers();
      } catch (e) {
        alertEl.textContent = e.message;
        alertEl.style.display = 'block';
      } finally { btnLoad(btn, false); }
    }

    async function rejectUser(id, name) {
      const btn = event.target;
      btnLoad(btn, true, '…');
      try {
        const r = await fetch('/api/users/' + id + '/reject', { method: 'PUT' });
        const d = await r.json(); if (d.error) throw new Error(d.error);
        toast('🚫 ' + name + ' rejected.');
        await loadUsers();
      } catch (e) { toast('❌ ' + e.message); }
      finally { btnLoad(btn, false); }
    }

    async function deleteUser(id, name) {
      if (!confirm(`Delete user "${name}"? This cannot be undone.`)) return;
      try {
        const r = await fetch('/api/users/' + id, { method: 'DELETE' });
        const d = await r.json(); if (d.error) throw new Error(d.error);
        toast('🗑️ User deleted.');
        await loadUsers();
      } catch (e) { toast('❌ ' + e.message); }
    }

    // ── Help / Guide modal ────────────────────────────────────────
    let _helpStep = 0;
    const HELP_STEPS = ['🔐 Login', '📝 Register', '📊 Dashboard', '📋 Bills', '💳 Loans'];

    function openHelp() {
      _helpStep = 0;
      _renderHelpTabs();
      _showHelpSlide(0);
      document.getElementById('help-overlay').classList.add('open');
    }

    function closeHelp() {
      document.getElementById('help-overlay').classList.remove('open');
    }

    document.addEventListener('keydown', e => {
      if (e.key === 'Escape' && document.getElementById('help-overlay').classList.contains('open')) closeHelp();
    });

    function helpNav(dir) {
      const next = _helpStep + dir;
      if (next < 0 || next >= HELP_STEPS.length) return;
      _showHelpSlide(next);
    }

    function _renderHelpTabs() {
      const container = document.getElementById('help-tabs');
      container.innerHTML = HELP_STEPS.map((label, i) =>
        `<button class="help-step-tab${i === _helpStep ? ' active' : ''}" onclick="_showHelpSlide(${i})">${label}</button>`
      ).join('');
    }

    function _showHelpSlide(n) {
      _helpStep = n;
      document.querySelectorAll('.help-slide').forEach((el, i) => {
        el.classList.toggle('active', i === n);
      });
      document.querySelectorAll('.help-step-tab').forEach((el, i) => {
        el.classList.toggle('active', i === n);
      });
      const counter = document.getElementById('help-counter');
      if (counter) counter.textContent = `Step ${n + 1} of ${HELP_STEPS.length}`;
      const prev = document.getElementById('btn-help-prev');
      const next = document.getElementById('btn-help-next');
      if (prev) prev.disabled = n === 0;
      if (next) {
        next.textContent = n === HELP_STEPS.length - 1 ? '✓ Done' : 'Next →';
        next.onclick = n === HELP_STEPS.length - 1 ? closeHelp : () => helpNav(1);
      }
    }

    // ── Change own password ───────────────────────────────────────
    function openChangePw() {
      document.getElementById('cpw-current').value = '';
      document.getElementById('cpw-new').value = '';
      document.getElementById('cpw-confirm').value = '';
      pwAlert('changepw-alert', '', '');
      document.getElementById('changepw-overlay').classList.add('open');
      document.getElementById('cpw-current').focus();
    }
    function closeChangePw() {
      document.getElementById('changepw-overlay').classList.remove('open');
    }
    async function saveChangePw() {
      const cur = document.getElementById('cpw-current').value;
      const np = document.getElementById('cpw-new').value;
      const conf = document.getElementById('cpw-confirm').value;
      if (!cur) return pwAlert('changepw-alert', 'error', 'Current password is required.');
      if (np.length < 6) return pwAlert('changepw-alert', 'error', 'New password must be at least 6 characters.');
      if (np !== conf) return pwAlert('changepw-alert', 'error', 'Passwords do not match.');
      const btn = document.getElementById('btn-changepw-save');
      btnLoad(btn, true, 'Saving…');
      try {
        const r = await fetch('/api/change-password', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ currentPassword: cur, newPassword: np })
        });
        const d = await r.json();
        if (d.error) throw new Error(d.error);
        pwAlert('changepw-alert', 'success', '✅ Password updated successfully!');
        setTimeout(closeChangePw, 1500);
        toast('✅ Password changed!');
      } catch (e) { pwAlert('changepw-alert', 'error', e.message); }
      finally { btnLoad(btn, false, 'Update Password'); }
    }
    document.getElementById('changepw-overlay').addEventListener('click', e => {
      if (e.target === e.currentTarget) closeChangePw();
    });

    // ── Admin reset user password ─────────────────────────────────
    let resetPwTargetId = null;
    function openResetPw(id, name) {
      resetPwTargetId = id;
      document.getElementById('resetpw-sub').textContent = `Reset password for: ${name}`;
      document.getElementById('rpw-new').value = '';
      document.getElementById('rpw-confirm').value = '';
      pwAlert('resetpw-alert', '', '');
      document.getElementById('resetpw-overlay').classList.add('open');
      document.getElementById('rpw-new').focus();
    }
    function closeResetPw() {
      document.getElementById('resetpw-overlay').classList.remove('open');
      resetPwTargetId = null;
    }
    async function saveResetPw() {
      const np = document.getElementById('rpw-new').value;
      const conf = document.getElementById('rpw-confirm').value;
      if (np.length < 6) return pwAlert('resetpw-alert', 'error', 'Password must be at least 6 characters.');
      if (np !== conf) return pwAlert('resetpw-alert', 'error', 'Passwords do not match.');
      const btn = document.getElementById('btn-resetpw-save');
      btnLoad(btn, true, 'Saving…');
      try {
        const r = await fetch(`/api/users/${resetPwTargetId}/reset-password`, {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ newPassword: np })
        });
        const d = await r.json();
        if (d.error) throw new Error(d.error);
        pwAlert('resetpw-alert', 'success', '✅ Password reset successfully!');
        setTimeout(closeResetPw, 1500);
        toast('✅ Password reset!');
      } catch (e) { pwAlert('resetpw-alert', 'error', e.message); }
      finally { btnLoad(btn, false, 'Reset Password'); }
    }
    document.getElementById('resetpw-overlay').addEventListener('click', e => {
      if (e.target === e.currentTarget) closeResetPw();
    });

    function pwAlert(elId, type, msg) {
      const el = document.getElementById(elId);
      if (!type) { el.style.display = 'none'; return; }
      el.style.display = 'flex';
      el.style.background = type === 'error' ? '#fef2f2' : '#f0fdf4';
      el.style.border = type === 'error' ? '1px solid #fecaca' : '1px solid #bbf7d0';
      el.style.color = type === 'error' ? '#991b1b' : '#166534';
      el.textContent = msg;
    }

    // ── Change user group ─────────────────────────────────────────
    let changeGroupTargetId = null;

    function openChangeGroup(id, username, currentCode) {
      changeGroupTargetId = id;
      document.getElementById('changegroup-sub').textContent = `User: ${username}`;
      pwAlert('changegroup-alert', '', '');
      // Populate dropdown with all groups
      const sel = document.getElementById('cg-group');
      sel.innerHTML = allGroups.map(g =>
        `<option value="${g.Code}" ${g.Code === currentCode ? 'selected' : ''}>${g.Name}</option>`
      ).join('');
      document.getElementById('changegroup-overlay').classList.add('open');
    }

    function closeChangeGroup() {
      document.getElementById('changegroup-overlay').classList.remove('open');
      changeGroupTargetId = null;
    }

    async function saveChangeGroup() {
      const groupCode = document.getElementById('cg-group').value;
      if (!groupCode) return pwAlert('changegroup-alert', 'error', 'Please select a group.');
      const btn = document.getElementById('btn-changegroup-save');
      btnLoad(btn, true, 'Saving…');
      try {
        const r = await fetch(`/api/users/${changeGroupTargetId}/group`, {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ groupCode })
        });
        const d = await r.json();
        if (d.error) throw new Error(d.error);
        const gName = allGroups.find(g => g.Code === groupCode)?.Name || groupCode;
        toast('✅ Moved to group: ' + gName);
        closeChangeGroup();
        await loadUsers();
      } catch (e) { pwAlert('changegroup-alert', 'error', e.message); }
      finally { btnLoad(btn, false, 'Save'); }
    }

    document.getElementById('changegroup-overlay').addEventListener('click', e => {
      if (e.target === e.currentTarget) closeChangeGroup();
    });

    // ════ GROUPS ════════════════════════════════════════════
    async function loadGroups() {
      try {
        const res = await fetch('/api/groups');
        allGroups = await res.json();
        renderGroups();
        if (isAdminSession) buildGroupSwitcher();
      } catch (e) { toast('❌ Could not load groups'); }
    }

    function renderGroups() {
      const tbl = document.getElementById('groups-table');
      const em = document.getElementById('groups-empty');
      document.getElementById('groups-count').textContent = `${allGroups.length} groups`;
      if (!allGroups.length) { tbl.style.display = 'none'; em.style.display = ''; return; }
      em.style.display = 'none'; tbl.style.display = '';
      document.getElementById('groups-body').innerHTML = allGroups.map(g => {
        const date = g.CreatedAt ? new Date(g.CreatedAt).toLocaleDateString('en-PH', { year: 'numeric', month: 'short', day: 'numeric' }) : '—';
        return `<tr>
          <td><span class="bill-id">#${g.ID}</span></td>
          <td><div class="bill-name">🏠 ${esc(g.Name)}</div></td>
          <td><code style="background:var(--bg);padding:2px 6px;border-radius:5px;font-size:12px">${esc(g.Code)}</code></td>
          <td><span class="muted-cell">${esc(g.Description || '—')}</span></td>
          <td><span class="st-badge st-paid">${g.memberCount || 0} members</span></td>
          <td><span class="muted-cell">${date}</span></td>
          <td><div class="actions">
            <button class="btn-ic bi-del" title="Delete" onclick="deleteGroup(${g.ID},'${esc(g.Name)}',${g.memberCount || 0})">🗑</button>
          </div></td>
        </tr>`;
      }).join('');
    }

    let groupModalEdit = null;

    function autoGroupCode(name) {
      const lock = document.getElementById('gf-code-lock');
      if (lock.dataset.manual === 'true') return; // user typed their own code — don't overwrite
      const code = name.trim()
        .toLowerCase()
        .replace(/[^a-z0-9]+/g, '_')   // non-alphanumeric → underscore
        .replace(/^_+|_+$/g, '')        // trim leading/trailing underscores
        .slice(0, 20);
      document.getElementById('gf-code').value = code;
    }

    function openGroupModal() {
      groupModalEdit = null;
      document.getElementById('gf-name').value = '';
      document.getElementById('gf-code').value = '';
      document.getElementById('gf-desc').value = '';
      const lock = document.getElementById('gf-code-lock');
      lock.textContent = 'auto ✨';
      lock.dataset.manual = 'false';
      document.getElementById('group-modal-title').textContent = 'Add Group';
      document.getElementById('group-modal-overlay').classList.add('open');
      document.getElementById('gf-name').focus();
    }

    function closeGroupModal() {
      document.getElementById('group-modal-overlay').classList.remove('open');
    }

    async function saveGroup() {
      const name = document.getElementById('gf-name').value.trim();
      const code = document.getElementById('gf-code').value.trim().toLowerCase();
      const desc = document.getElementById('gf-desc').value.trim();
      if (!name) return toast('⚠️ Group name is required');
      if (!code) return toast('⚠️ Group code is required');
      if (!/^[a-zA-Z0-9_-]{2,20}$/.test(code)) return toast('⚠️ Code: 2–20 chars, letters/numbers/_ - only');
      const btn = document.getElementById('btn-group-save');
      btnLoad(btn, true, 'Saving…');
      try {
        const r = await fetch('/api/groups', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ name, code, description: desc })
        });
        const d = await r.json();
        if (d.error) throw new Error(d.error);
        toast('✅ Group "' + name + '" created!');
        closeGroupModal();
        await loadGroups();
        document.getElementById('page-sub').textContent = `${allGroups.length} groups`;
      } catch (e) { toast('❌ ' + e.message); }
      finally { btnLoad(btn, false, 'Save Group'); }
    }

    async function deleteGroup(id, name, memberCount) {
      if (memberCount > 0) return toast('⚠️ Cannot delete a group with members');
      if (!confirm(`Delete group "${name}"?`)) return;
      try {
        const r = await fetch('/api/groups/' + id, { method: 'DELETE' });
        const d = await r.json(); if (d.error) throw new Error(d.error);
        toast('🗑️ Group deleted.');
        await loadGroups();
      } catch (e) { toast('❌ ' + e.message); }
    }

    document.getElementById('group-modal-overlay').addEventListener('click', e => {
      if (e.target === e.currentTarget) closeGroupModal();
    });

    // If admin manually edits the code field, stop auto-generating
    document.getElementById('gf-code').addEventListener('input', () => {
      const lock = document.getElementById('gf-code-lock');
      lock.textContent = '✏️';
      lock.dataset.manual = 'true';
    });

    document.querySelectorAll('.tab[data-user-filter]').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.tab[data-user-filter]').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        userFilter = btn.dataset.userFilter;
        renderUsers();
      });
    });

    // ── Loan filter tabs ──────────────────────────────────────────
    document.querySelectorAll('.tab[data-loan-filter]').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.tab[data-loan-filter]').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        loanFilterStatus = btn.dataset.loanFilter;
        renderLoans();
      });
    });
    document.getElementById('loan-search').addEventListener('input', renderLoans);

    // ════════════════════════════════════════
    //  NOTIFICATION BELL
    // ════════════════════════════════════════

    function buildNotifications() {
      const today = new Date(); today.setHours(0, 0, 0, 0);
      const in7 = new Date(today); in7.setDate(in7.getDate() + 7);
      const ago7 = new Date(today); ago7.setDate(ago7.getDate() - 7);

      const overdue = [];
      const dueSoon = [];
      const recentlyPaid = [];

      bills.forEach(b => {
        const st = effectiveStatus(b);
        if (!b['Due Date']) return;
        const due = new Date(b['Due Date']); due.setHours(0, 0, 0, 0);

        if (st === 'Overdue') {
          overdue.push(b);
        } else if (st === 'Unpaid' && due >= today && due <= in7) {
          dueSoon.push(b);
        }
        if (st === 'Paid' && b['Payment Date']) {
          const pd = new Date(b['Payment Date']); pd.setHours(0, 0, 0, 0);
          if (pd >= ago7) recentlyPaid.push(b);
        }
      });

      // Sort
      overdue.sort((a, b) => new Date(a['Due Date']) - new Date(b['Due Date']));
      dueSoon.sort((a, b) => new Date(a['Due Date']) - new Date(b['Due Date']));
      recentlyPaid.sort((a, b) => new Date(b['Payment Date']) - new Date(a['Payment Date']));

      return { overdue, dueSoon, recentlyPaid };
    }

    function daysLabel(dateStr) {
      const today = new Date(); today.setHours(0, 0, 0, 0);
      const d = new Date(dateStr); d.setHours(0, 0, 0, 0);
      const diff = Math.round((d - today) / 86400000);
      if (diff === 0) return 'Due today';
      if (diff === 1) return 'Due tomorrow';
      if (diff < 0) return Math.abs(diff) + ' day' + (Math.abs(diff) > 1 ? 's' : '') + ' overdue';
      return 'Due in ' + diff + ' day' + (diff > 1 ? 's' : '');
    }

    function updateNotifBadge() {
      const { overdue, dueSoon } = buildNotifications();
      const count = overdue.length + dueSoon.length;
      const badge = document.getElementById('notif-badge');
      badge.textContent = count > 99 ? '99+' : count;
      badge.style.display = count > 0 ? 'flex' : 'none';
    }

    function renderNotifPanel() {
      const { overdue, dueSoon, recentlyPaid } = buildNotifications();
      const total = overdue.length + dueSoon.length;
      document.getElementById('notif-count-label').textContent =
        total > 0 ? total + ' action needed' : 'All clear';

      const body = document.getElementById('notif-body');
      let html = '';

      if (!overdue.length && !dueSoon.length && !recentlyPaid.length) {
        html = `<div class="notif-empty">🎉 No pending bills or recent activity.</div>`;
      }

      if (overdue.length) {
        html += `<div class="notif-section-label">🚨 Overdue (${overdue.length})</div>`;
        html += overdue.map(b => `
        <div class="notif-item">
          <span class="notif-icon">❗</span>
          <div class="notif-body">
            <div class="notif-name">${esc(b['Bill Name'])}</div>
            <div class="notif-meta" style="color:#ef4444">${daysLabel(b['Due Date'])} · ${esc(b.Category || '')}</div>
          </div>
          <span class="notif-amt" style="color:#ef4444">${fmt(b.Amount)}</span>
        </div>`).join('');
      }

      if (dueSoon.length) {
        html += `<div class="notif-section-label">⏰ Due Soon (${dueSoon.length})</div>`;
        html += dueSoon.map(b => `
        <div class="notif-item">
          <span class="notif-icon">📅</span>
          <div class="notif-body">
            <div class="notif-name">${esc(b['Bill Name'])}</div>
            <div class="notif-meta" style="color:#f59e0b">${daysLabel(b['Due Date'])} · ${esc(b.Category || '')}</div>
          </div>
          <span class="notif-amt" style="color:#f59e0b">${fmt(b.Amount)}</span>
        </div>`).join('');
      }

      if (recentlyPaid.length) {
        html += `<div class="notif-section-label">✅ Recently Paid (${recentlyPaid.length})</div>`;
        html += recentlyPaid.map(b => `
        <div class="notif-item">
          <span class="notif-icon">✅</span>
          <div class="notif-body">
            <div class="notif-name">${esc(b['Bill Name'])}</div>
            <div class="notif-meta" style="color:var(--success)">Paid ${fmtDate(b['Payment Date'])} · ${esc(b.Category || '')}</div>
          </div>
          <span class="notif-amt" style="color:var(--success)">${fmt(b.Amount)}</span>
        </div>`).join('');
      }

      body.innerHTML = html;
    }

    document.getElementById('btn-bell').addEventListener('click', e => {
      e.stopPropagation();
      const panel = document.getElementById('notif-panel');
      const opening = !panel.classList.contains('open');
      panel.classList.toggle('open');
      if (opening) renderNotifPanel();
    });

    // Close panel when clicking anywhere outside
    document.addEventListener('click', e => {
      const wrap = document.querySelector('.notif-wrap');
      if (!wrap.contains(e.target)) {
        document.getElementById('notif-panel').classList.remove('open');
      }
    });

    // ════════════════════════════════════════
    //  DARK MODE
    // ════════════════════════════════════════
    (function initTheme() {
      const saved = localStorage.getItem('theme') || 'light';
      document.documentElement.setAttribute('data-theme', saved);
      document.getElementById('btn-theme').textContent = saved === 'dark' ? '☀️' : '🌙';
    })();

    document.getElementById('btn-theme').addEventListener('click', () => {
      const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
      const next = isDark ? 'light' : 'dark';
      document.documentElement.setAttribute('data-theme', next);
      document.getElementById('btn-theme').textContent = next === 'dark' ? '☀️' : '🌙';
      localStorage.setItem('theme', next);
    });

    // ════════════════════════════════════════
    //  SPENDING CHARTS
    // ════════════════════════════════════════
    let chartCategory = null;
    let chartMonthly = null;

    function renderCharts(src) {
      if (typeof Chart === 'undefined') return;

      // Category doughnut — use ALL bills in the period (not just paid)
      const cats = {};
      src.forEach(b => {
        const c = b.Category || 'Others';
        cats[c] = (cats[c] || 0) + (parseFloat(b.Amount) || 0);
      });
      const palette = ['#6366f1', '#22c55e', '#f59e0b', '#ef4444', '#a855f7', '#0ea5e9', '#f97316', '#14b8a6', '#ec4899'];
      const catLabels = Object.keys(cats);
      const catData = catLabels.map(k => cats[k]);
      const catColors = catLabels.map((_, i) => palette[i % palette.length]);

      if (chartCategory) { chartCategory.destroy(); chartCategory = null; }
      const ctxCat = document.getElementById('chart-category').getContext('2d');
      chartCategory = new Chart(ctxCat, {
        type: 'doughnut',
        data: {
          labels: catLabels.length ? catLabels : ['No Bills'],
          datasets: [{
            data: catLabels.length ? catData : [1],
            backgroundColor: catLabels.length ? catColors : ['#e2e8f0'],
            borderWidth: 2, borderColor: '#fff'
          }]
        },
        options: {
          responsive: true, maintainAspectRatio: false,
          plugins: {
            legend: { position: 'right', labels: { font: { size: 11 }, boxWidth: 12, padding: 8 } },
            tooltip: {
              callbacks: {
                label: ctx => {
                  const val = ctx.parsed;
                  const total = ctx.dataset.data.reduce((a, b) => a + b, 0);
                  const pct = total > 0 ? Math.round((val / total) * 100) : 0;
                  return ` ₱${val.toLocaleString('en-PH', { minimumFractionDigits: 2 })} (${pct}%)`;
                }
              }
            }
          }
        }
      });

      // Monthly bar (last 6 months, total billed vs paid)
      const months = [];
      for (let i = 5; i >= 0; i--) {
        const d = new Date(); d.setDate(1); d.setMonth(d.getMonth() - i);
        months.push(d.toISOString().slice(0, 7));
      }
      const totalByMonth = months.map(m => bills.filter(b => b['Due Date'] && b['Due Date'].slice(0, 7) === m).reduce((s, b) => s + (parseFloat(b.Amount) || 0), 0));
      const paidByMonth = months.map(m => bills.filter(b => b['Due Date'] && b['Due Date'].slice(0, 7) === m && effectiveStatus(b) === 'Paid').reduce((s, b) => s + (parseFloat(b.Amount) || 0), 0));

      if (chartMonthly) chartMonthly.destroy();
      const ctxMo = document.getElementById('chart-monthly').getContext('2d');
      chartMonthly = new Chart(ctxMo, {
        type: 'bar',
        data: {
          labels: months.map(m => { const d = new Date(m + '-01'); return d.toLocaleString('default', { month: 'short', year: '2-digit' }); }),
          datasets: [
            { label: 'Total', data: totalByMonth, backgroundColor: 'rgba(99,102,241,.25)', borderColor: '#6366f1', borderWidth: 2, borderRadius: 4 },
            { label: 'Paid', data: paidByMonth, backgroundColor: 'rgba(34,197,94,.4)', borderColor: '#22c55e', borderWidth: 2, borderRadius: 4 }
          ]
        },
        options: {
          responsive: true, maintainAspectRatio: false,
          plugins: { legend: { labels: { font: { size: 11 }, boxWidth: 12 } } },
          scales: { y: { beginAtZero: true, ticks: { callback: v => '₱' + v.toLocaleString() } } }
        }
      });

      renderBudgetBars(src);
    }

    // ════════════════════════════════════════
    //  BUDGET LIMITS
    // ════════════════════════════════════════
    const BUDGET_KEY = 'expense-budgets';
    const CATEGORIES = ['Utilities', 'Rent', 'Internet', 'Phone', 'Insurance', 'Supplies', 'Salary', 'Government', 'Others'];

    function loadBudgets() {
      try { return JSON.parse(localStorage.getItem(BUDGET_KEY)) || {}; }
      catch { return {}; }
    }

    function renderBudgetBars(src) {
      const budgets = loadBudgets();
      const active = CATEGORIES.filter(c => budgets[c] > 0);
      if (!active.length) { document.getElementById('budget-bars').innerHTML = ''; return; }
      const now = new Date();
      const mo = now.toISOString().slice(0, 7);
      const spent = {};
      src.filter(b => b['Due Date'] && b['Due Date'].slice(0, 7) === mo).forEach(b => {
        const c = b.Category || 'Others';
        spent[c] = (spent[c] || 0) + (parseFloat(b.Amount) || 0);
      });
      document.getElementById('budget-bars').innerHTML = active.map(cat => {
        const limit = budgets[cat];
        const s = spent[cat] || 0;
        const pct = Math.min(100, Math.round((s / limit) * 100));
        const color = pct >= 100 ? '#ef4444' : pct >= 80 ? '#f59e0b' : '#22c55e';
        return `<div class="budget-item">
        <span class="budget-label">${cat}</span>
        <div class="budget-bar-wrap"><div class="budget-bar" style="width:${pct}%;background:${color}"></div></div>
        <span class="budget-pct" style="color:${color}">${pct}%</span>
      </div>`;
      }).join('');
    }

    function openBudgetSettings() {
      const budgets = loadBudgets();
      document.getElementById('budget-fields').innerHTML = CATEGORIES.map(cat => `
      <div class="field">
        <label>${cat}</label>
        <input type="number" data-budget-cat="${cat}" placeholder="₱ limit" min="0" step="100"
          value="${budgets[cat] || ''}" style="width:100%" />
      </div>`).join('');
      document.getElementById('budget-modal-overlay').classList.add('open');
    }

    document.getElementById('btn-budget-save').onclick = () => {
      const budgets = {};
      document.querySelectorAll('[data-budget-cat]').forEach(inp => {
        const v = parseFloat(inp.value);
        if (v > 0) budgets[inp.dataset.budgetCat] = v;
      });
      localStorage.setItem(BUDGET_KEY, JSON.stringify(budgets));
      document.getElementById('budget-modal-overlay').classList.remove('open');
      renderCharts(bills); toast('✅ Budget limits saved!');
    };
    document.getElementById('btn-budget-cancel').onclick = () =>
      document.getElementById('budget-modal-overlay').classList.remove('open');
    document.getElementById('budget-modal-overlay').addEventListener('click', e => {
      if (e.target.id === 'budget-modal-overlay') document.getElementById('budget-modal-overlay').classList.remove('open');
    });

    // Wire charts into updateDashboard — patch in after bills filter
    const _origUpdateDashboard = updateDashboard;
    updateDashboard = function () {
      _origUpdateDashboard();
      let src = bills;
      if (dashFilterMonth) src = src.filter(b => b['Due Date'] && b['Due Date'].slice(0, 7) === dashFilterMonth);
      if (dashFilterCutoff) src = src.filter(b => matchesCutoff(b, dashFilterCutoff));
      renderCharts(src);
    };

    // ════════════════════════════════════════
    //  CALENDAR VIEW
    // ════════════════════════════════════════
    let calYear = new Date().getFullYear();
    let calMonth = new Date().getMonth();

    function setView(v) {
      document.getElementById('list-view').style.display = v === 'list' ? '' : 'none';
      document.getElementById('cal-view').style.display = v === 'calendar' ? '' : 'none';
      document.getElementById('btn-list-view').classList.toggle('active', v === 'list');
      document.getElementById('btn-cal-view').classList.toggle('active', v === 'calendar');
      if (v === 'calendar') renderCalendar();
    }

    function calPrev() { calMonth--; if (calMonth < 0) { calMonth = 11; calYear--; } renderCalendar(); }
    function calNext() { calMonth++; if (calMonth > 11) { calMonth = 0; calYear++; } renderCalendar(); }

    function renderCalendar() {
      const monthNames = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];
      document.getElementById('cal-month-label').textContent = `${monthNames[calMonth]} ${calYear}`;
      const today = new Date(); today.setHours(0, 0, 0, 0);
      const first = new Date(calYear, calMonth, 1);
      const last = new Date(calYear, calMonth + 1, 0);
      const startDow = first.getDay();
      const cells = [];
      // padding cells before
      const prevLast = new Date(calYear, calMonth, 0).getDate();
      for (let i = startDow - 1; i >= 0; i--) cells.push({ day: prevLast - i, cur: false });
      // current month
      for (let d = 1; d <= last.getDate(); d++) cells.push({ day: d, cur: true });
      // padding after
      const rem = 7 - (cells.length % 7); if (rem < 7) for (let d = 1; d <= rem; d++) cells.push({ day: d, cur: false });

      // Map bills to day
      const byDay = {};
      bills.forEach(b => {
        if (!b['Due Date']) return;
        const bd = new Date(b['Due Date']); bd.setHours(0, 0, 0, 0);
        if (bd.getFullYear() !== calYear || bd.getMonth() !== calMonth) return;
        const d = bd.getDate(); if (!byDay[d]) byDay[d] = [];
        byDay[d].push(b);
      });

      document.getElementById('cal-grid').innerHTML = cells.map(c => {
        const isToday = c.cur && c.day === today.getDate() && today.getFullYear() === calYear && today.getMonth() === calMonth;
        const bs = c.cur ? (byDay[c.day] || []) : [];
        const dotsHtml = bs.slice(0, 3).map(b => {
          const st = effectiveStatus(b);
          const cls = st === 'Paid' ? 'cal-dot-paid' : st === 'Overdue' ? 'cal-dot-overdue' : 'cal-dot-unpaid';
          return `<div class="cal-bill-dot ${cls}">${esc(b['Bill Name'])}</div>`;
        }).join('') + (bs.length > 3 ? `<div class="cal-bill-dot" style="color:var(--muted)">+${bs.length - 3} more</div>` : '');
        return `<div class="cal-cell${!c.cur ? ' other-month' : ''}${isToday ? ' today' : ''}">
        <div class="cal-day-num">${c.day}</div>
        ${dotsHtml}
      </div>`;
      }).join('');
    }

    // ════════════════════════════════════════
    //  LOAN ALERTS IN BELL
    // ════════════════════════════════════════
    const _origBuildNotifications = buildNotifications;
    buildNotifications = function () {
      const base = _origBuildNotifications();
      const today = new Date(); today.setHours(0, 0, 0, 0);
      const in7 = new Date(today); in7.setDate(in7.getDate() + 7);
      const overdueLns = [];
      const dueSoonLns = [];
      loans.forEach(l => {
        const st = effectiveLoanStatus(l);
        if (st === 'Overdue') { overdueLns.push(l); return; }
        if (st === 'Active' && l['Due Day']) {
          const now2 = new Date();
          const due2 = new Date(now2.getFullYear(), now2.getMonth(), parseInt(l['Due Day']));
          due2.setHours(0, 0, 0, 0);
          if (due2 >= today && due2 <= in7) dueSoonLns.push(l);
        }
      });
      return { ...base, overdueLns, dueSoonLns };
    };

    const _origUpdateNotifBadge = updateNotifBadge;
    updateNotifBadge = function () {
      const { overdue, dueSoon, overdueLns, dueSoonLns } = buildNotifications();
      const count = overdue.length + dueSoon.length + overdueLns.length + dueSoonLns.length;
      const badge = document.getElementById('notif-badge');
      badge.textContent = count > 99 ? '99+' : count;
      badge.style.display = count > 0 ? 'flex' : 'none';
    };

    const _origRenderNotifPanel = renderNotifPanel;
    renderNotifPanel = function () {
      _origRenderNotifPanel();
      const { overdueLns, dueSoonLns } = buildNotifications();
      if (!overdueLns.length && !dueSoonLns.length) return;
      const body = document.getElementById('notif-body');
      let extra = '';
      if (overdueLns.length) {
        extra += `<div class="notif-section-label">🚨 Loans Overdue (${overdueLns.length})</div>`;
        extra += overdueLns.map(l => `<div class="notif-item"><span class="notif-icon">💳</span><div class="notif-body"><div class="notif-name">${esc(l['Loan Name'])}</div><div class="notif-meta" style="color:#ef4444">Overdue · ${esc(l.Lender || '')}</div></div><span class="notif-amt" style="color:#ef4444">${fmt(l['Monthly Payment'])}</span></div>`).join('');
      }
      if (dueSoonLns.length) {
        extra += `<div class="notif-section-label">⏰ Loans Due Soon (${dueSoonLns.length})</div>`;
        extra += dueSoonLns.map(l => `<div class="notif-item"><span class="notif-icon">💳</span><div class="notif-body"><div class="notif-name">${esc(l['Loan Name'])}</div><div class="notif-meta" style="color:#f59e0b">Due day ${l['Due Day']} · ${esc(l.Lender || '')}</div></div><span class="notif-amt" style="color:#f59e0b">${fmt(l['Monthly Payment'])}</span></div>`).join('');
      }
      body.insertAdjacentHTML('beforeend', extra);
      // Update count label
      const { overdue, dueSoon } = buildNotifications();
      const total = overdue.length + dueSoon.length + overdueLns.length + dueSoonLns.length;
      document.getElementById('notif-count-label').textContent = total > 0 ? total + ' action needed' : 'All clear';
    };


  </script>
</body>

</html>